
:root{--ink:#0f172a;--muted:#64748b;--line:#e2e8f0;--bg:#f4f6f8;--white:#fff;--accent:#f59e0b;--accent2:#d97706;--success:#059669;--danger:#dc2626;--shadow:0 12px 30px rgba(15,23,42,.07)}
