:var(--accent);color:#111827;font-size:9px}.chat-launcher{position:fixed;right:22px;bottom:90px;width:48px;height:48px;border:1px solid #e2e8f0;border-radius:50%;background:#fff;color:#b45309;box-shadow:0 12px 30px rgba(15,23,42,.13);z-index:65;cursor:pointer;font-size:18px}.chatbot{position:fixed;right:22px;bottom:145px;width:350px;background:#fff;border:1px solid var(--line);border-radius:20px;box-shadow:0 25px 55px rgba(15,23,42,.22);z-index:110;display:none;overflow:hidden}.chatbot.show{display:block}.chat-header{display:flex;justify-content:space-between;align-items:center;padding:14px;border-bottom:1px solid var(--line);background:#f8fafc}.chat-agent{display:flex;align-items:center;gap:9px}.agent-orb{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:var(--ink);color:var(--accent)}.chat-agent strong,.chat-agent small{display:block}.chat-agent strong{font-size:11px}.chat-agent small{font-size:9px;color:var(--muted);margin-top:2px}.chat-messages{height:260px;overflow:auto;padding:14px;background:#fff}.chat-bubble{max-width:84%;padding:9px 11px;border-radius:13px;font-size:10px;line-height:1.55;margin-bottom:8px}.chat-bubble.bot{background:#f1f5f9;color:#334155}.chat-bubble.user{margin-left:auto;background:#0f172a;color:#fff}.chat-suggestions{display:flex;gap:5px;flex-wrap:wrap;padding:9px 12px;border-top:1px solid #eef2f7}.chat-suggestions button{border:1px solid var(--line);background:#fff;border-radius:999px;padding:6px 8px;font-size:8px;font-weight:900;cursor:pointer}.chat-input{display:flex;border-top:1px solid var(--line);padding:9px;gap:7px}.chat-input input{flex:1;border:1px solid var(--line);border-radius:10px;padding:9px;outline:0;font-size:10px}.chat-input button{border:0;border-radius:10px;width:37px;background:var(--ink);color:#fff;cursor:pointer}.toast-container{position:fixed;right:20px;top:92px;z-index:150;display:flex;flex-direction:column;gap:8px}.toast{min-width:220px;max-width:340px;padding:11px 13px;border-radius:12px;background:#0f172a;color:#fff;display:flex;gap:8px;align-items:center;box-shadow:0 14px 30px rgba(15,23,42,.2);font-size:11px}.toast.success span{color:#34d399}.toast.error span{color:#fca5a5}.toast.info span{color:#93c5fd}.mobile-menu,.sidebar-close{display:none}.mobile-overlay{display:none}
.login-body{min-height:100vh;margin:0;background:#f4f6f8;color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;display:grid;place-items:center;overflow:hidden;position:relative}.login-bg-shape{position:absolute;border-radius:50%;filter:blur(1px);opacity:.55}.shape-a{width:440px;height:440px;right:-160px;top:-130px;background:#fff1d6}.shape-b{width:340px;height:340px;left:-160px;bottom:-130px;background:#e9eef5}.login-wrap{width:min(450px,92vw);position:relative;z-index:1}.login-brand{text-align:center;margin-bottom:19px}.login-logo{width:64px;height:64px;border-radius:19px;margin:0 auto 12px}.login-logo span{font-size:25px}.login-brand h1{margin:5px 0 0;font-size:29px;letter-spacing:-.04em}.login-brand p{font-size:11px;color:var(--muted);margin:6px 0 0}.login-card{background:#fff;border:1px solid var(--line);border-radius:23px;padding:24px;box-shadow:0 24px 55px rgba(15,23,42,.09)}.login-heading{display:flex;justify-content:space-between;gap:14px;align-items:flex-start}.login-heading h2{font-size:20px;margin:5px 0 0}.login-heading p{font-size:10px;color:var(--muted);margin:5px 0 0}.security-badge{background:#ecfdf5;color:#047857;padding:5px 8px;border-radius:999px;font-size:8px;font-weight:900;white-space:nowrap}.alert-error{margin:14px 0 0;border:1px solid #fecaca;background:#fef2f2;color:#b91c1c;padding:10px;border-radius:11px;font-size:10px;font-weight:800}.login-form{margin-top:18px}.login-form>label{display:block;font-size:10px;font-weight:900;color:#334155;margin-bottom:13px}.login-form>label>input{display:block;margin-top:6px;border:1px solid var(--line);background:#f8fafc;border-radius:11px;padding:12px}.password-field{display:flex;border:1px solid var(--line);background:#f8fafc;border-radius:11px;margin-top:6px}.password-field input{padding:12px;border:0;outline:0;background:transparent}.password-field button{width:42px;border:0;background:transparent;cursor:pointer;color:#64748b}.login-options{display:flex;justify-content:space-between;align-items:center;font-size:9px;color:#94a3b8;margin-bottom:14px}.check-row{display:flex!important;align-items:center;gap:7px;margin:0!important;font-weight:700!important;color:#475569!important}.check-row input{accent-color:#0f172a}.demo-access{margin-top:14px;border:1px dashed #cbd5e1;background:#f8fafc;padding:11px;border-radius:12px;display:flex;flex-direction:column;gap:3px}.demo-access strong{font-size:9px}.demo-access span,.demo-access small{font-size:9px;color:var(--muted)}.login-footer{text-align:center;font-size:9px;color:#94a3b8;margin-top:14px}
@media(max-width:1100px){.product-grid{grid-template-columns:repeat(3,1fr)}.stats-grid{grid-template-columns:repeat(2,1fr)}.orders-grid{grid-template-columns:repeat(2,1fr)}.category-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:900px){.app-sidebar{transform:translateX(-100%);transition:.22s}.app-sidebar.open{transform:translateX(0)}.app-shell{margin-left:0}.mobile-menu{display:grid}.sidebar-close{display:grid}.mobile-overlay.show{display:block;position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:65}.dashboard-grid,.reservation-layout,.checkout-grid,.product-detail{grid-template-columns:1fr}.order-summary{position:static}.detail-image{height:300px}.info-grid{grid-template-columns:1fr 1fr}.kanban{grid-template-columns:1fr}.kanban-col{min-height:auto}.top-user{display:none}.topbar{padding:0 18px}.page-content{padding:22px 17px}.floor-plan{height:520px}}
@media(max-width:650px){.page-head,.hero-panel,.panel-head,.toolbar-row{align-items:flex-start;flex-direction:column}.hero-panel{padding:22px}.page-head h2,.hero-panel h2{font-size:25px}.stats-grid,.product-grid,.category-grid,.orders-grid,.info-grid{grid-template-columns:1fr}.quick-grid,.payment-methods{grid-template-columns:1fr}.cart-line{grid-template-columns:60px 1fr auto}.cart-line>img{width:60px;height:60px}.line-total{grid-column:2}.line-remove{grid-column:3;grid-row:1}.floating-cart{right:15px;bottom:15px}.chat-launcher{right:15px;bottom:80px}.chatbot{right:12px;bottom:137px;width:calc(100vw - 24px)}.floor-plan{height:430px}.restaurant-table.round{width:60px;height:60px}.restaurant-table.square{width:66px;height:56px}.restaurant-table.rect{width:82px;height:56px}.restaurant-table strong{font-size:11px}.restaurant-table small{font-size:8px}.two-col{grid-template-columns:1fr}.login-card{padding:19px}.topbar{height:70px}.cart-pill span:nth-child(2){display:none}.search-box{min-width:100%}}
.category-image{height:150px;overflow:hidden;background:#f8fafc;border-bottom:1px solid #e2e8f0}.category-image img{width:100%;height:100%;object-fit:cover;display:block}.category-image img.image-missing{opacity:0}.category-modal{width:min(1100px,94vw);max-height:90vh;overflow:auto;border-radius:22px;background:#fff;padding:28px;position:relative}.modal-heading{margin-bottom:20px}.category-modal .product-grid{margin-top:0}.notification-item{display:flex;gap:14px;padding:18px;border-bottom:1px solid #e2e8f0}.notification-item>div:nth-child(2){flex:1}.notification-item small{display:block;color:#94a3b8;margin-top:5px}.notification-item p{margin-top:7px;color:#64748b;font-size:13px}.notification-icon{width:40px;height:40px;display:grid;place-items:center;border-radius:10px;background:#f8fafc;color:#b45309;flex:none}.notification-item.unread{background:#fffbeb}.image-missing{background:#f8fafc;min-height:100%;object-fit:cover}

.admin-product-list{display:grid;gap:12px}.admin-product-row{display:grid;grid-template-columns:90px 1fr auto;gap:18px;align-items:center;padding:16px;border:1px solid #e2e8f0;border-radius:14px;background:#fff}.admin-product-row img{width:90px;height:70px;border-radius:10px;object-fit:cover;background:#f8fafc}.admin-product-row small,.admin-product-row em{display:block;color:#94a3b8;font-size:11px;margin-top:4px}.admin-product-row p{margin:6px 0;color:#64748b;font-size:13px}.admin-actions{display:flex;gap:8px}.danger-btn{border:0;border-radius:10px;background:#fee2e2;color:#b91c1c;padding:9px 12px;font-weight:800}.admin-modal{max-width:850px}.admin-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:20px}.admin-form-grid .full-field{grid-column:1/-1}.modal-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:22px}.modal-help,.field-hint{display:block;color:#94a3b8;font-size:11px;margin-top:5px}.cash-note{margin:12px 0;padding:10px 12px;border-radius:10px;background:#fffbeb;color:#92400e;font-size:12px}.owner-table-summary{min-height:250px}.table-status-key{display:grid;gap:18px;margin-top:25px}.table-status-key div{display:grid;grid-template-columns:auto 1fr;column-gap:10px}.table-status-key small{grid-column:2;color:#94a3b8;font-size:11px}@media(max-width:700px){.admin-form-grid{grid-template-columns:1fr}.admin-form-grid .full-field{grid-column:auto}.admin-product-row{grid-template-columns:65px 1fr}.admin-product-row img{width:65px;height:60px}.admin-actions{grid-column:1/-1}}
/* Extensiones mínimas para autenticación y pagos. No alteran los estilos existentes. */
.login-tabs{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:18px;padding:4px;background:#f8fafc;border:1px solid var(--line);border-radius:12px}.login-tab{border:0;background:transparent;color:#64748b;padding:9px;border-radius:9px;font-size:10px;font-weight:900;cursor:pointer}.login-tab.active{background:#fff;color:var(--ink);box-shadow:0 2px 8px rgba(15,23,42,.07)}.login-panel.hidden{display:none}.alert-success{margin:14px 0 0;border:1px solid #bbf7d0;background:#f0fdf4;color:#047857;padding:10px;border-radius:11px;font-size:10px;font-weight:800}.muted-text,.form-help{color:var(--muted);font-weight:600}.form-help{display:block;margin:-4px 0 13px;font-size:9px}.payment-inline{display:grid;grid-template-columns:1fr 1fr;gap:10px;width:100%}.transfer-data{width:100%;padding:9px;border-radius:9px;background:#f8fafc;border:1px dashed #cbd5e1;display:flex;flex-direction:column;gap:2px}.transfer-data strong,.transfer-data span{font-size:9px}.order-payment-line{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:10px}.paid-note,.cash-note{margin-top:10px;padding:9px 10px;border-radius:10px;font-size:9px}.paid-note{background:#ecfdf5;border:1px solid #bbf7d0;color:#047857;display:flex;justify-content:space-between;gap:8px}.cash-note{background:#fffbeb;border:1px solid #fde68a;color:#92400e}

/* Mejoras del menú y administración, añadidas sin alterar los estilos existentes. */
.menu-search-panel{margin:0 0 26px;background:#fff;border:1px solid #e2e8f0;border-radius:20px;padding:20px;box-shadow:0 10px 28px rgba(15,23,42,.05)}
.menu-search-title{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:15px}.menu-search-title h3,.category-section-head h3{margin:4px 0 0;font-size:18px;font-weight:950}.menu-search-title .eyebrow{margin:0}.filter-hint{font-size:10px;font-weight:800;color:#94a3b8}.menu-filter-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr 1fr auto;gap:10px;align-items:end}.filter-field{display:flex;flex-direction:column;gap:7px}.filter-field>span{font-size:9px;text-transform:uppercase;letter-spacing:.08em;font-weight:900;color:#64748b}.search-wide{min-width:0}.filter-clear{height:42px;white-space:nowrap}.category-section-head{margin:0 0 14px}.category-section-head p{margin:4px 0 0;color:#94a3b8;font-size:11px}.page-head-actions{display:flex;gap:9px;align-items:center}.admin-work-grid{display:grid;grid-template-columns:minmax(0,1.75fr) minmax(280px,.75fr);gap:16px}.admin-category-panel{position:sticky;top:18px;height:max-content}.admin-category-list{display:flex;flex-direction:column;gap:9px}.admin-category-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px;border:1px solid #e2e8f0;border-radius:13px;background:#f8fafc}.admin-category-row strong{display:block;font-size:11px}.admin-category-row small{display:block;color:#94a3b8;font-size:9px;margin-top:3px}.admin-category-row>span{font-size:8px;font-weight:900;text-transform:uppercase;letter-spacing:.05em;color:#b45309;background:#fffbeb;border-radius:999px;padding:5px 7px}.category-admin-modal{max-width:700px}
@media(max-width:1050px){.menu-filter-grid{grid-template-columns:repeat(2,1fr)}.search-wide{grid-column:1/-1}.filter-clear{width:100%}.admin-work-grid{grid-template-columns:1fr}.admin-category-panel{position:static}}
@media(max-width:650px){.menu-search-title{align-items:flex-start;flex-direction:column}.menu-filter-grid{grid-template-columns:1fr}.search-wide{grid-column:auto}.page-head-actions{width:100%;flex-direction:column}.page-head-actions>*{width:100%;justify-content:center}.admin-work-grid{gap:12px}}

.ready-toolbar{display:flex;gap:10px;justify-content:space-between;align-items:center}.ready-search{flex:1;max-width:620px}.cash-note span{display:block;margin-top:4px;color:var(--muted)}.order-status-note{font-size:10px;color:var(--muted);align-self:center}

/* Gestión de personal, perfiles, reservas y domicilios */
.hidden{display:none!important}.worker-list{display:grid;gap:10px;margin-top:18px}.worker-card{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:14px;align-items:center;padding:15px;border:1px solid var(--line);border-radius:14px;background:#fff}.worker-main strong,.worker-main small{display:block}.worker-main small{font-size:10px;color:var(--muted);margin-top:4px}.worker-role{justify-self:end}.worker-actions{grid-column:2/-1;display:flex;gap:8px;flex-wrap:wrap}.worker-actions form{display:flex;gap:8px;align-items:center}.worker-actions select{border:1px solid var(--line);border-radius:10px;padding:8px 10px;background:#fff;font-size:11px}.worker-form{margin-top:18px}.profile-hero{display:flex;gap:16px;align-items:center;padding-bottom:20px;border-bottom:1px solid var(--line)}.profile-avatar{width:68px;height:68px;border-radius:18px;background:#fff7ed;color:#b45309;display:grid;place-items:center;font-size:25px;font-weight:950}.profile-hero h3{margin:9px 0 3px;font-size:20px}.profile-hero p{margin:0;color:var(--muted);font-size:12px}.profile-data{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:18px}.profile-data div{padding:13px;border:1px solid #eef2f7;border-radius:12px;background:#f8fafc}.profile-data span,.profile-data strong{display:block}.profile-data span{font-size:9px;color:#94a3b8;text-transform:uppercase;letter-spacing:.08em;font-weight:900}.profile-data strong{font-size:12px;margin-top:5px;word-break:break-word}.delivery-fields{display:grid;gap:10px;margin-top:10px;padding:12px;border:1px dashed #cbd5e1;border-radius:12px;background:#f8fafc}.delivery-fields textarea{width:100%;resize:vertical;border:1px solid var(--line);border-radius:10px;padding:11px;background:#fff;outline:none}.order-context{margin-top:10px;padding:10px 12px;border-radius:10px;background:#f8fafc;color:#475569;font-size:11px;font-weight:800}.reservation-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end}.legend-dot.warning{background:#f59e0b}.status-pill.warning{background:#fffbeb;color:#b45309}.ready-card .cash-note{display:grid;gap:3px}.ready-card .cash-note span{margin-top:0}.restaurant-table:disabled{cursor:not-allowed;opacity:.78}
@media(max-width:700px){.worker-card{grid-template-columns:auto 1fr}.worker-role{grid-column:2;justify-self:start}.worker-actions{grid-column:1/-1}.worker-actions form{width:100%}.worker-actions select,.worker-actions button{flex:1}.profile-data{grid-template-columns:1fr}.reservation-actions{justify-content:flex-start}}

/* Acceso público y controles añadidos */
.public-menu-shell{min-height:100vh;background:#f8fafc}
.public-menu-header{height:76px;display:flex;align-items:center;justify-content:space-between;padding:0 34px;border-bottom:1px solid #e2e8f0;background:rgba(255,255,255,.96);position:sticky;top:0;z-index:50;backdrop-filter:blur(12px)}
.public-brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:#0f172a}
.public-brand .brand-mark{width:40px;height:40px;border-radius:12px;overflow:hidden;display:grid;place-items:center;background:#0f172a}
.public-brand .brand-mark img{width:100%;height:100%;object-fit:cover}
.public-login-btn{min-width:150px;justify-content:center}
.login-required-note{margin-top:12px;padding:16px;border:1px solid #dbe4ef;background:#f8fafc;border-radius:14px}
.login-required-note strong{display:block;font-size:12px;color:#0f172a}
.login-required-note p{margin:6px 0 12px;font-size:10px;line-height:1.6;color:#64748b}
.worker-admin-grid{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(310px,.8fr);gap:16px}
.card-preview-wrap{margin-top:14px}
.bank-card{width:min(100%,390px);aspect-ratio:1.586;background:linear-gradient(135deg,#0f172a,#273449 55%,#0b1220);border-radius:18px;padding:20px;color:#fff;box-shadow:0 18px 40px rgba(15,23,42,.2);display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;position:relative}
.bank-card:before{content:"";position:absolute;inset:auto -20% -45% auto;width:220px;height:220px;border-radius:50%;background:rgba(255,255,255,.06)}
.bank-card-top,.bank-card-bottom{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;position:relative;z-index:1}
.bank-card-top span{font-size:10px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
.bank-card-number{position:relative;z-index:1;font-size:20px;font-weight:800;letter-spacing:.16em;white-space:nowrap}
.bank-card-bottom>div{display:flex;flex-direction:column;gap:3px;min-width:0}.bank-card-bottom small{font-size:7px;opacity:.68;letter-spacing:.1em}.bank-card-bottom strong{font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:210px}
.payment-fields .field-label input:invalid,.form-stack .field-label input:invalid,.login-form input:invalid{box-shadow:0 0 0 1px rgba(220,38,38,.18)}
@media(max-width:1050px){.worker-admin-grid{grid-template-columns:1fr}.public-menu-header{padding:0 20px}}
@media(max-width:650px){.public-menu-header{height:68px;padding:0 14px}.public-login-btn{min-width:auto;padding-left:13px;padding-right:13px}.bank-card{padding:16px}.bank-card-number{font-size:16px;letter-spacing:.11em}.bank-card-bottom strong{max-width:150px}}


/* ==========================================================
   RestauranteBD · refinamiento profesional
   ========================================================== */
.login-body {
    min-height: 100vh;
    margin: 0;
    overflow-x: hidden;
    overflow-y: auto;
    background: #f3f6fa;
    position: relative;
}

.login-page-shell {
    min-height: calc(100vh - 48px);
    width: min(1120px, 92vw);
    margin: 0 auto;
    padding: 44px 0 24px;
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(380px, 520px);
    gap: 48px;
    align-items: center;
    position: relative;
    z-index: 2;
}

.login-welcome {
    text-align: center;
    max-width: 520px;
    margin: 0 auto;
}

.login-logo-large {
    width: 82px;
    height: 82px;
    border-radius: 24px;
    margin: 0 auto 18px;
    box-shadow: 0 22px 50px rgba(15,23,42,.14);
}

.login-welcome h1 {
    font-size: clamp(34px, 4.5vw, 52px);
    letter-spacing: -.055em;
    margin: 10px 0 10px;
}

.login-welcome p {
    max-width: 470px;
    margin: 0 auto;
    color: #64748b;
    line-height: 1.75;
    font-size: 13px;
}

.login-feature-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-top: 28px;
}

.login-feature-row div {
    padding: 13px 10px;
    border: 1px solid #dfe6ee;
    background: rgba(255,255,255,.72);
    border-radius: 15px;
}

.login-feature-row strong,
.login-feature-row span {
    display: block;
}

.login-feature-row strong {
    font-size: 12px;
}

.login-feature-row span {
    margin-top: 4px;
    color: #94a3b8;
    font-size: 9px;
}

.login-card-professional {
    max-height: calc(100vh - 56px);
    overflow-y: auto;
    padding: 28px;
    box-shadow: 0 28px 70px rgba(15,23,42,.12);
}

.login-card-professional::-webkit-scrollbar {
    width: 8px;
}

.login-card-professional::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 999px;
}

.login-tabs-professional {
    margin-bottom: 22px;
}

.login-heading-centered {
    display: block;
    text-align: center;
}

.login-heading-centered .eyebrow,
.login-heading-centered h2,
.login-heading-centered p {
    display: block;
}

.login-form-centered {
    width: min(100%, 410px);
    margin-left: auto;
    margin-right: auto;
}

.login-submit {
    margin-top: 4px;
}

.login-switch-note {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    margin-top: 18px;
    font-size: 10px;
    color: #94a3b8;
}

.login-switch-note button {
    border: 0;
    background: transparent;
    color: #b45309;
    font-weight: 900;
    cursor: pointer;
}

.password-policy {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px 12px;
    margin: -2px 0 14px;
    padding: 10px;
    border: 1px solid #e5eaf0;
    background: #f8fafc;
    border-radius: 12px;
    font-size: 9px;
    color: #64748b;
}

.password-policy > span {
    grid-column: 1 / -1;
    font-weight: 900;
    color: #334155;
}

.password-policy div {
    display: flex;
    gap: 6px;
    align-items: center;
}

.password-policy i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid #cbd5e1;
    background: white;
}

.password-policy i.valid {
    background: #10b981;
    border-color: #10b981;
}

.professional-footer {
    position: relative;
    z-index: 2;
    margin: 0 auto 18px;
}

.login-bg-glow {
    position: fixed;
    width: 460px;
    height: 460px;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(14px);
    opacity: .5;
}

.glow-one {
    right: -180px;
    top: -170px;
    background: #fff0d4;
}

.glow-two {
    left: -180px;
    bottom: -190px;
    background: #e5edf7;
}

.phone-country-field {
    display: grid;
    grid-template-columns: minmax(150px, .55fr) minmax(0, 1fr);
    gap: 10px;
}

.phone-country-field .field-label {
    margin: 0;
}

.phone-number-label {
    min-width: 0;
}

.phone-country-field select,
.phone-country-field input,
.field-label textarea {
    width: 100%;
    margin-top: 6px;
    border: 1px solid var(--line);
    background: #f8fafc;
    border-radius: 11px;
    padding: 12px;
    outline: none;
    color: var(--ink);
}

.phone-country-field select:focus,
.phone-country-field input:focus,
.field-label textarea:focus {
    border-color: #94a3b8;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(148,163,184,.12);
}

.top-profile-link {
    color: inherit;
    text-decoration: none;
    padding: 5px 7px;
    border-radius: 12px;
}

.top-profile-link:hover {
    background: #f8fafc;
}

.profile-chevron {
    color: #94a3b8;
    font-size: 11px;
}

.role-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 7px 10px;
    font-size: 9px;
    font-weight: 900;
    background: #f1f5f9;
    color: #475569;
}

.role-dueno { background: #fff7ed; color: #9a3412; }
.role-cocina { background: #eff6ff; color: #1d4ed8; }
.role-barra { background: #f0fdfa; color: #0f766e; }
.role-repartidor { background: #f5f3ff; color: #6d28d9; }
.role-cliente { background: #f0fdf4; color: #15803d; }

.worker-search-toolbar {
    margin: 15px 0 0;
}

.worker-search-toolbar .search-box {
    max-width: 680px;
}

.worker-name-line {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
}

.inline-form {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    flex-wrap: wrap;
}

.inline-label {
    display: flex;
    flex-direction: column;
    gap: 5px;
    color: #64748b;
    font-size: 9px;
    font-weight: 900;
}

.inline-label select {
    min-width: 120px;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 8px 10px;
    background: #fff;
}

.worker-promotion-panel {
    align-self: start;
    position: sticky;
    top: 96px;
}

.worker-client-preview {
    padding: 13px;
    border: 1px dashed #cbd5e1;
    border-radius: 13px;
    background: #f8fafc;
}

.worker-client-preview span,
.worker-client-preview strong {
    display: block;
}

.worker-client-preview span {
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: .08em;
    font-size: 8px;
    font-weight: 900;
}

.worker-client-preview strong {
    margin-top: 4px;
    color: #475569;
    font-size: 11px;
}

.worker-client-preview.ready {
    border-color: #bbf7d0;
    background: #f0fdf4;
}

.worker-client-preview.ready span {
    color: #15803d;
}

.role-permission-summary {
    display: grid;
    gap: 7px;
    padding: 12px;
    border: 1px solid #e2e8f0;
    border-radius: 13px;
    background: #f8fafc;
}

.role-permission-summary div {
    display: flex;
    justify-content: space-between;
    gap: 10px;
}

.role-permission-summary strong {
    font-size: 10px;
}

.role-permission-summary span {
    color: #64748b;
    font-size: 9px;
    text-align: right;
}

.customer-search-panel {
    margin-bottom: 18px;
}

.customer-search-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 9px;
    margin-top: 15px;
}

.customer-search-input {
    width: 100%;
}

.customer-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
}

.customer-card {
    border: 1px solid var(--line);
    border-radius: 18px;
    background: #fff;
    padding: 18px;
    box-shadow: var(--shadow);
}

.customer-card-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 14px;
    border-bottom: 1px solid #eef2f7;
}

.customer-card-head h3 {
    margin: 5px 0 2px;
    font-size: 15px;
}

.customer-card-head p {
    margin: 0;
    color: #94a3b8;
    font-size: 10px;
}

.customer-avatar {
    flex: none;
}

.customer-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9px;
    padding-top: 14px;
}

.customer-details div {
    padding: 10px;
    background: #f8fafc;
    border-radius: 11px;
}

.customer-details span,
.customer-details strong {
    display: block;
}

.customer-details span {
    color: #94a3b8;
    font-size: 8px;
    text-transform: uppercase;
    letter-spacing: .08em;
    font-weight: 900;
}

.customer-details strong {
    margin-top: 4px;
    font-size: 10px;
    word-break: break-word;
}

.customer-detail-wide,
.profile-data-wide {
    grid-column: 1 / -1;
}

.customer-readonly-note {
    margin-top: 12px;
    padding: 9px 10px;
    border-radius: 10px;
    background: #f8fafc;
    color: #64748b;
    font-size: 9px;
}

.profile-layout {
    display: grid;
    grid-template-columns: 1.25fr .75fr;
    gap: 18px;
}

.profile-summary-panel {
    min-width: 0;
}

.profile-hero-large {
    padding-bottom: 22px;
}

.profile-protection-note {
    margin-top: 16px;
    padding: 14px;
    border: 1px solid #e2e8f0;
    border-radius: 13px;
    background: #f8fafc;
}

.profile-protection-note span,
.profile-protection-note strong,
.profile-protection-note p {
    display: block;
}

.profile-protection-note span {
    color: #94a3b8;
    font-size: 8px;
    text-transform: uppercase;
    letter-spacing: .08em;
    font-weight: 900;
}

.profile-protection-note strong {
    margin-top: 5px;
    font-size: 11px;
}

.profile-protection-note p {
    margin: 5px 0 0;
    color: #64748b;
    font-size: 9px;
    line-height: 1.55;
}

.payment-layout-premium {
    align-items: start;
}

.payment-main-panel {
    min-width: 0;
}

.payment-security-badge {
    display: inline-flex;
    gap: 7px;
    align-items: center;
    padding: 8px 10px;
    border-radius: 999px;
    background: #f0fdf4;
    color: #15803d;
    font-size: 9px;
    font-weight: 900;
}

.payment-security-badge span {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #16a34a;
    color: #fff;
}

.payment-methods-premium .payment-method {
    min-height: 74px;
    transition: .18s ease;
}

.payment-methods-premium .payment-method:hover {
    transform: translateY(-1px);
}

.payment-methods-premium .payment-method > span {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: #f8fafc;
    font-size: 10px;
    font-weight: 950;
}

.payment-method-detail {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
}

.payment-method-symbol {
    width: 35px;
    height: 35px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    background: #0f172a;
    color: #fff;
    font-weight: 950;
    font-size: 10px;
}

.payment-field-wide {
    grid-column: 1 / -1;
}

.payment-security-line {
    grid-column: 1 / -1;
    padding: 9px 10px;
    border-radius: 10px;
    background: #f8fafc;
    color: #64748b;
    font-size: 9px;
}

.payment-security-line span {
    color: #16a34a;
    font-weight: 900;
}

.transfer-data-pro {
    grid-column: 1 / -1;
}

.card-stage {
    padding: 18px;
    border-radius: 18px;
    background: linear-gradient(145deg, #f8fafc, #eef2f7);
    border: 1px solid #e2e8f0;
}

.bank-card-premium {
    max-width: 430px;
    margin: 0 auto;
    box-shadow: 0 24px 45px rgba(15,23,42,.22);
}

.bank-card-shine {
    position: absolute;
    width: 280px;
    height: 280px;
    right: -100px;
    top: -130px;
    border-radius: 50%;
    background: rgba(255,255,255,.08);
}

.card-preview-type {
    position: absolute;
    right: 20px;
    bottom: 18px;
    z-index: 1;
    color: rgba(255,255,255,.6);
    font-size: 7px;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.card-preview-caption {
    margin: 9px 0 0;
    text-align: center;
    color: #94a3b8;
    font-size: 9px;
}

.premium-pay-total {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}

.premium-pay-total small {
    color: #94a3b8;
    font-size: 8px;
}

.payment-final-note {
    display: block;
    margin-top: 11px;
    color: #94a3b8;
    font-size: 8px;
    line-height: 1.5;
}

.payment-confirm-button {
    margin-top: 5px;
}

.chat-action-button {
    border: 1px solid #cbd5e1;
    background: #fff;
    color: #0f172a;
    border-radius: 9px;
    padding: 8px 10px;
    font-size: 9px;
    font-weight: 900;
    cursor: pointer;
}

.chat-action-button:hover {
    background: #f8fafc;
}

.chat-product-results {
    display: grid;
    gap: 7px;
    margin-top: 7px;
}

.chat-product-option {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    padding: 9px;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    background: #fff;
}

.chat-product-option strong,
.chat-product-option span,
.chat-product-option small {
    display: block;
}

.chat-product-option strong {
    font-size: 9px;
}

.chat-product-option span {
    color: #b45309;
    font-size: 9px;
    font-weight: 900;
    margin-top: 2px;
}

.chat-product-option small {
    color: #64748b;
    font-size: 8px;
    margin-top: 2px;
    line-height: 1.4;
}

.chat-product-option button {
    border: 0;
    border-radius: 8px;
    background: #0f172a;
    color: #fff;
    padding: 7px 8px;
    font-size: 8px;
    font-weight: 900;
    cursor: pointer;
}

.walkin-form-block {
    display: grid;
    gap: 10px;
    padding: 13px;
    margin: 14px 0;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #f8fafc;
}

@media (max-width: 980px) {
    .login-page-shell,
    .profile-layout,
    .customer-grid,
    .worker-admin-grid {
        grid-template-columns: 1fr;
    }

    .login-page-shell {
        width: min(620px, 92vw);
        padding-top: 28px;
    }

    .login-welcome {
        max-width: 620px;
    }

    .worker-promotion-panel {
        position: static;
    }
}

@media (max-width: 650px) {
    .login-page-shell {
        width: min(94vw, 520px);
        padding-top: 18px;
    }

    .login-card-professional {
        max-height: none;
        overflow: visible;
        padding: 20px;
    }

    .login-feature-row,
    .phone-country-field,
    .customer-search-form,
    .customer-details {
        grid-template-columns: 1fr;
    }

    .customer-detail-wide,
    .profile-data-wide {
        grid-column: auto;
    }

    .customer-search-form > * {
        width: 100%;
    }
}


/* Ajustes finales: iconografía, tarjeta completa y pedidos presenciales */
.nav-icon svg,
.cart-icon svg,
.agent-orb svg,
.chat-launcher svg,
.payment-icon svg {
    width: 19px;
    height: 19px;
    display: block;
}

.cart-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.cart-pill .cart-icon svg {
    width: 18px;
    height: 18px;
}

.floating-cart .cart-icon svg {
    width: 23px;
    height: 23px;
}

.chat-launcher {
    display: grid;
    place-items: center;
}

.chat-launcher svg {
    width: 23px;
    height: 23px;
}

.agent-orb {
    display: grid;
    place-items: center;
}

.login-info-grid {
    display: grid;
    gap: 10px;
    margin-top: 26px;
}

.login-info-grid article {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    text-align: left;
    padding: 13px 14px;
    border: 1px solid #dfe6ee;
    background: rgba(255,255,255,.78);
    border-radius: 15px;
}

.login-info-icon {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: #f8fafc;
    color: #b45309;
    font-size: 15px;
    font-weight: 900;
}

.login-info-grid strong,
.login-info-grid span {
    display: block;
}

.login-info-grid strong {
    font-size: 11px;
}

.login-info-grid article div span {
    margin-top: 4px;
    color: #64748b;
    font-size: 9px;
    line-height: 1.5;
}

.payment-method > span.payment-icon {
    color: #0f172a;
}

.payment-method-detail .payment-icon {
    color: #fff;
}

.bank-card-number {
    letter-spacing: .11em;
    font-variant-numeric: tabular-nums;
    overflow: hidden;
    text-overflow: clip;
}

.page-head-actions {
    display: flex;
    align-items: center;
    gap: 8px;
}

.local-order-modal {
    width: min(980px, 94vw);
    max-height: min(88vh, 860px);
    overflow: auto;
}

.local-order-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, .75fr);
    gap: 18px;
    margin-top: 18px;
}

.local-product-add {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 110px auto;
    align-items: end;
    gap: 10px;
    margin-top: 16px;
    padding: 14px;
    border: 1px solid #e5eaf0;
    border-radius: 14px;
    background: #f8fafc;
}

.local-qty-field input {
    min-width: 0;
}

.local-order-summary {
    padding: 16px;
    border: 1px solid #e5eaf0;
    border-radius: 16px;
    background: #fbfcfe;
}

.compact-head {
    margin-bottom: 12px;
}

.local-order-lines {
    display: grid;
    gap: 8px;
    max-height: 310px;
    overflow: auto;
    margin-bottom: 14px;
}

.local-order-line {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    align-items: center;
    padding: 10px 11px;
    border: 1px solid #e5eaf0;
    background: #fff;
    border-radius: 12px;
}

.local-order-line strong,
.local-order-line small {
    display: block;
}

.local-order-line strong {
    font-size: 10px;
}

.local-order-line small {
    margin-top: 3px;
    font-size: 9px;
    color: #64748b;
}

.danger-icon {
    color: #dc2626;
}

@media(max-width: 820px) {
    .local-order-grid {
        grid-template-columns: 1fr;
    }
}

@media(max-width: 650px) {
    .page-head-actions {
        width: 100%;
        flex-direction: column;
        align-items: stretch;
    }

    .page-head-actions button {
        width: 100%;
        justify-content: center;
    }

    .local-product-add {
        grid-template-columns: 1fr;
    }
}


.payment-tab-icon {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    background: #f8fafc;
    color: #0f172a;
    flex: 0 0 36px;
}

.payment-tab-icon svg {
    width: 19px;
    height: 19px;
}

.payment-method.active .payment-tab-icon {
    background: #0f172a;
    color: #fff;
}

@media(max-width: 650px) {
    .bank-card-number {
        font-size: 14px;
        letter-spacing: .07em;
    }
}


.login-info-icon svg {
    width: 18px;
    height: 18px;
}

/* Refinamiento final: bienvenida, iconos y controles consistentes */
.login-intro-splash{position:fixed;inset:0;z-index:200;display:flex;flex-direction:column;align-items:center;justify-content:center;background:radial-gradient(circle at 50% 42%,rgba(255,247,237,.98),rgba(243,246,250,.99) 58%,#edf2f7 100%);text-align:center;animation:loginSplashOut .95s cubic-bezier(.4,0,.2,1) 1.35s forwards;pointer-events:none}
.login-intro-mark{width:102px;height:102px;border-radius:30px;display:grid;place-items:center;overflow:hidden;background:#0f172a;box-shadow:0 28px 65px rgba(15,23,42,.2);animation:loginLogoIn .75s cubic-bezier(.16,1,.3,1) .1s both}
.login-intro-mark img{width:100%;height:100%;object-fit:contain}
.login-intro-mark span{display:none;width:100%;height:100%;place-items:center;color:#f59e0b;font-size:31px;font-weight:950}
.login-intro-splash .eyebrow{margin-top:22px;animation:loginTextIn .6s ease .35s both}
.login-intro-splash h1{margin:8px 0 3px;font-size:38px;letter-spacing:-.05em;animation:loginTextIn .6s ease .45s both}
.login-intro-splash p{margin:0;color:#64748b;font-size:13px;animation:loginTextIn .6s ease .55s both}
.login-page-shell{opacity:0;transform:translateY(14px);animation:loginContentIn .8s cubic-bezier(.16,1,.3,1) 1.05s forwards}
.login-welcome-copy{max-width:500px;margin-left:auto!important;margin-right:auto!important}
.login-info-grid-single{margin-top:24px}
.login-info-grid-single article{box-shadow:0 10px 25px rgba(15,23,42,.045)}
@keyframes loginLogoIn{from{opacity:0;transform:scale(.72) rotate(-5deg)}to{opacity:1;transform:scale(1) rotate(0)}}
@keyframes loginTextIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
@keyframes loginContentIn{to{opacity:1;transform:none}}
@keyframes loginSplashOut{to{opacity:0;visibility:hidden}}
.ui-icon{width:19px;height:19px;display:inline-grid;place-items:center;flex:none}
.ui-icon svg{width:100%;height:100%;display:block}
.side-nav a .ui-icon{color:#64748b}
.side-nav a:hover .ui-icon,.side-nav a.active .ui-icon{color:#b45309}
.action-icon{width:17px;height:17px;display:inline-block;vertical-align:-3px}
.action-icon svg{width:100%;height:100%;display:block}
.icon-btn{display:inline-grid;place-items:center}
.icon-btn .ui-icon{width:18px;height:18px}
.product-add-btn{width:38px;height:38px;padding:0!important;border-radius:12px!important;display:grid!important;place-items:center;background:#0f172a!important;color:#fff!important;box-shadow:0 8px 18px rgba(15,23,42,.13)}
.product-add-btn:hover{background:#1e293b!important;transform:translateY(-1px)}
.product-add-btn svg{width:19px;height:19px}
.product-view-btn{display:inline-flex;align-items:center;gap:6px}
.menu-result-actions{display:flex;align-items:center;gap:8px}
@media(max-width:650px){.login-intro-splash h1{font-size:31px}.login-intro-mark{width:88px;height:88px}.product-add-btn{width:42px;height:42px}}

.password-toggle{position:absolute;right:7px;top:50%;transform:translateY(-50%);width:34px;height:34px;display:grid;place-items:center;border:0;border-radius:9px;background:transparent;color:#64748b;cursor:pointer}
.password-toggle:hover{background:#f8fafc;color:#0f172a}
.password-toggle .ui-icon{width:17px;height:17px}
.notification-icon svg{width:19px;height:19px;display:block}
.cart-empty-icon{width:30px;height:30px;margin-bottom:8px;color:#b45309}
.product-card:focus-visible{outline:3px solid rgba(245,158,11,.28);outline-offset:3px}
@media(prefers-reduced-motion:reduce){.login-intro-splash,.login-intro-mark,.login-intro-splash .eyebrow,.login-intro-splash h1,.login-intro-splash p,.login-page-shell{animation:none!important}.login-intro-splash{opacity:0;visibility:hidden}.login-page-shell{opacity:1;transform:none}}

/* Bandeja de notificaciones profesional */
.notification-center{overflow:hidden;padding:0}.notification-toolbar{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:16px 18px;border-bottom:1px solid var(--line);background:#fff}.notification-toolbar-tabs{display:flex;gap:6px;flex-wrap:wrap}.notification-search{min-width:min(330px,45vw)}.notification-list-head{display:flex;justify-content:space-between;padding:11px 18px;border-bottom:1px solid #eef2f7;color:#94a3b8;font-size:9px;font-weight:900;text-transform:uppercase;letter-spacing:.06em}.notification-row{display:grid;grid-template-columns:32px 42px minmax(0,1fr) auto;align-items:center;gap:12px;min-height:78px;padding:10px 16px;border-bottom:1px solid #eef2f7;transition:background .15s ease}.notification-row:hover{background:#f8fafc}.notification-row.unread{background:#fffdf5}.notification-star{border:0;background:transparent;color:#cbd5e1;font-size:20px;cursor:pointer;line-height:1}.notification-star.active{color:#f59e0b}.notification-icon{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:#f8fafc;color:#b45309}.notification-icon svg{width:19px;height:19px}.notification-main{min-width:0;text-align:left;border:0;background:transparent;padding:0;cursor:pointer}.notification-main-top{display:flex;align-items:center;justify-content:space-between;gap:12px}.notification-main-top strong{font-size:12px;color:#172033;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.notification-main-top time{font-size:9px;color:#94a3b8;white-space:nowrap}.notification-subject{font-size:11px;color:#334155;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.notification-main p{font-size:10px;color:#94a3b8;margin:4px 0 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.notification-row.read .notification-main-top strong,.notification-row.read .notification-subject{font-weight:700;color:#475569}.notification-row-actions{display:flex;align-items:center;gap:5px}.notification-action{display:inline-flex;align-items:center;gap:5px;border:1px solid var(--line);background:#fff;border-radius:9px;padding:7px 9px;color:#334155;font-size:9px;font-weight:900;cursor:pointer}.notification-action:hover{background:#f8fafc}.notification-action .ui-icon{width:15px;height:15px}.notification-empty{min-height:300px}.notification-empty .ui-icon{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:#f8fafc;color:#94a3b8}.notification-empty .ui-icon svg{width:20px;height:20px}@media(max-width:760px){.notification-toolbar{flex-direction:column;align-items:stretch}.notification-search{min-width:100%}.notification-row{grid-template-columns:26px 38px minmax(0,1fr)}.notification-row-actions{grid-column:3;justify-content:flex-end}.notification-main-top{align-items:flex-start;flex-direction:column;gap:2px}.notification-list-head{display:none}}

/* Detalle de notificación estilo correo */
.notification-detail-modal{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(15,23,42,.42);backdrop-filter:blur(4px);z-index:3000;padding:24px}.notification-detail-modal.show{display:flex}.notification-detail-dialog{width:min(780px,96vw);max-height:min(86vh,820px);overflow:auto;background:#fff;border:1px solid var(--line);border-radius:18px;box-shadow:0 24px 70px rgba(15,23,42,.22)}.notification-detail-head{display:flex;align-items:flex-start;gap:14px;padding:22px 24px 16px;border-bottom:1px solid #eef2f7}.notification-detail-icon{width:44px;height:44px;border-radius:12px;background:#f8fafc;display:grid;place-items:center;flex:0 0 auto}.notification-detail-icon svg{width:21px;height:21px}.notification-detail-title{min-width:0;flex:1}.notification-detail-title h3{margin:0;font-size:18px;color:#172033}.notification-detail-title .subject{margin:5px 0 0;color:#475569;font-size:12px}.notification-detail-title time{display:block;margin-top:8px;color:#94a3b8;font-size:10px}.notification-detail-close{border:0;background:transparent;cursor:pointer;color:#64748b;width:34px;height:34px;border-radius:9px}.notification-detail-close:hover{background:#f1f5f9}.notification-detail-body{padding:22px 24px 26px;color:#334155;font-size:12px;line-height:1.7}.mail-detail-card{margin-top:18px;border:1px solid #e7edf4;border-radius:12px;overflow:hidden}.mail-detail-row{display:flex;justify-content:space-between;gap:20px;padding:11px 14px;border-bottom:1px solid #eef2f7}.mail-detail-row:last-child{border-bottom:0}.mail-detail-row span{color:#64748b}.mail-detail-row strong{color:#172033}.mail-detail-meta{display:flex;justify-content:space-between;gap:16px;margin-top:18px;color:#94a3b8;font-size:10px}.notification-detail-foot{display:flex;justify-content:flex-end;gap:8px;padding:14px 24px;border-top:1px solid #eef2f7;background:#fbfcfe}.notification-star .ui-icon{width:20px;height:20px;display:grid;place-items:center}.notification-star .ui-icon svg{width:18px;height:18px}.notification-star.active{color:#f59e0b}.payment-method-symbol svg{width:21px;height:21px}.method-box>.payment-method-symbol{flex:0 0 auto;width:36px;height:36px;display:grid;place-items:center}


/* ===== Lectura de correo profesional para notificaciones ===== */
.gmail-center{border-radius:18px;box-shadow:0 12px 38px rgba(15,23,42,.06)}
.gmail-reader-dialog{width:min(1080px,97vw);max-height:92vh;display:flex;flex-direction:column;border-radius:18px;overflow:hidden}
.gmail-reader-toolbar{display:flex;align-items:center;justify-content:space-between;padding:10px 16px;border-bottom:1px solid #edf1f5;background:#fff;min-height:58px}
.gmail-reader-toolbar-actions{display:flex;align-items:center;gap:6px}
.gmail-reader-toolbar .icon-btn{width:38px;height:38px}
.gmail-reader-body{overflow:auto;background:#fff}
.gmail-reader-heading{display:flex;gap:14px;padding:26px 32px 10px}
.gmail-reader-subject-wrap{min-width:0;flex:1}
.gmail-reader-subject-wrap h3{margin:0;font-size:26px;line-height:1.2;letter-spacing:-.02em;color:#172033}
.gmail-labels{display:flex;gap:7px;align-items:center;margin-top:10px;flex-wrap:wrap}
.gmail-label{display:inline-flex;align-items:center;padding:4px 9px;border-radius:999px;background:#eef4ff;color:#3659a8;font-size:10px;font-weight:800}
.gmail-label.soft{background:#f1f5f9;color:#64748b}
.gmail-sender-row{display:grid;grid-template-columns:42px minmax(0,1fr) auto auto;gap:12px;align-items:center;padding:12px 32px 18px}
.gmail-sender-avatar{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:#334155;color:#fff;font-weight:800}
.gmail-sender-copy{display:grid;grid-template-columns:auto 1fr;column-gap:6px;align-items:center;min-width:0}
.gmail-sender-copy strong{color:#172033;font-size:13px}.gmail-sender-copy span{color:#94a3b8;font-size:11px;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.gmail-recipient{grid-column:1/-1;border:0;background:transparent;padding:0;color:#64748b;font-size:10px;text-align:left;cursor:pointer}
.gmail-sender-row>time{font-size:10px;color:#94a3b8;white-space:nowrap}.gmail-sender-row .icon-btn.active{color:#eab308}
.gmail-message-body{padding:4px 32px 30px;color:#334155;font-size:13px;line-height:1.75}
.mail-intro{padding:4px 0 4px}.mail-intro p{margin:0 0 16px;white-space:pre-line}.mail-reference{display:flex;justify-content:space-between;gap:20px;padding:10px 12px;background:#f8fafc;border:1px solid #edf1f5;border-radius:10px;font-size:10px}.mail-reference span{color:#64748b}.mail-reference strong{color:#172033}
.mail-section{margin-top:18px;border:1px solid #e6ebf1;border-radius:13px;overflow:hidden;background:#fff}.mail-section-title{display:flex;align-items:center;gap:9px;padding:12px 14px;border-bottom:1px solid #eef2f6;background:#fbfcfe}.mail-section-title strong{font-size:12px;color:#172033;flex:1}.mail-section-title .ui-icon{width:18px;height:18px;display:grid;place-items:center;color:#64748b}.mail-section-title .ui-icon svg{width:18px;height:18px}.mail-section-count{font-size:9px;color:#94a3b8;font-weight:800}
.mail-info-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0}.mail-info-grid>div{padding:12px 14px;border-bottom:1px solid #f0f3f6}.mail-info-grid>div:nth-last-child(-n+2){border-bottom:0}.mail-info-grid span{display:block;font-size:9px;color:#94a3b8;text-transform:uppercase;letter-spacing:.05em;font-weight:800;margin-bottom:4px}.mail-info-grid strong{font-size:11px;color:#172033;overflow-wrap:anywhere}
.mail-items-table{width:100%}.mail-items-head,.mail-item-row{display:grid;grid-template-columns:minmax(0,1fr) 82px 110px 110px;gap:10px;align-items:center;padding:11px 14px}.mail-items-head{font-size:9px;text-transform:uppercase;letter-spacing:.05em;font-weight:800;color:#94a3b8;background:#fcfdff}.mail-item-row{border-top:1px solid #f0f3f6;font-size:11px;color:#334155}.mail-item-row>span:first-child{overflow-wrap:anywhere}.mail-item-row>strong:last-child{text-align:right;color:#172033}.mail-item-row>span:nth-child(3),.mail-item-row>strong:nth-child(2){text-align:right}
.mail-note{display:flex;gap:10px;margin-top:18px;padding:14px;border-radius:12px;background:#f8fafc;border:1px solid #e8edf3}.mail-note .ui-icon{width:22px;height:22px;display:grid;place-items:center;color:#64748b;flex:none}.mail-note .ui-icon svg{width:20px;height:20px}.mail-note strong{font-size:11px;color:#172033}.mail-note p{margin:4px 0 0;font-size:11px;color:#64748b;white-space:pre-line}
.mail-received{display:flex;justify-content:space-between;gap:14px;padding:18px 0 0;color:#94a3b8;font-size:10px}.mail-received strong{color:#64748b}
.gmail-reader-footer{display:flex;justify-content:flex-end;gap:8px;padding:14px 24px;border-top:1px solid #edf1f5;background:#fbfcfe}
.card-brand-icon{width:36px;height:24px;display:grid;place-items:center;color:rgba(255,255,255,.92)}.card-brand-icon svg{width:26px;height:26px}
@media(max-width:760px){.gmail-reader-heading{padding:20px 18px 8px}.gmail-sender-row{padding:10px 18px 16px;grid-template-columns:36px minmax(0,1fr) auto}.gmail-sender-avatar{width:36px;height:36px}.gmail-sender-row>time{grid-column:2/-1}.gmail-message-body{padding:4px 18px 22px}.mail-info-grid{grid-template-columns:1fr}.mail-info-grid>div:nth-last-child(-n+2){border-bottom:1px solid #f0f3f6}.mail-info-grid>div:last-child{border-bottom:0}.mail-items-head,.mail-item-row{grid-template-columns:minmax(0,1fr) 55px 78px 86px;gap:6px;padding:10px 10px}.gmail-reader-subject-wrap h3{font-size:21px}}

/* ===== DETALLE VISUAL DEL CENTRO DE NOTIFICACIONES ===== */
.notification-head-tools{display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:flex-end}.notification-head-stat{display:flex;align-items:center;gap:8px;padding:8px 11px;border:1px solid var(--line);border-radius:12px;background:#fff;min-width:96px}.notification-head-stat>.ui-icon{width:28px;height:28px;display:grid;place-items:center;border-radius:9px;background:#f6f8fb;color:#64748b}.notification-head-stat>.ui-icon svg{width:16px;height:16px}.notification-head-stat div{display:grid;gap:1px}.notification-head-stat span{font-size:8px;color:#94a3b8;font-weight:800;text-transform:uppercase;letter-spacing:.05em}.notification-head-stat strong{font-size:13px;color:#172033}.notification-toolbar-brand{display:flex;align-items:center;gap:9px;margin-right:auto}.notification-toolbar-brand>.ui-icon{width:34px;height:34px;display:grid;place-items:center;background:#f6f8fb;border:1px solid #e8edf3;border-radius:10px;color:#64748b}.notification-toolbar-brand>.ui-icon svg{width:18px;height:18px}.notification-toolbar-brand div{display:grid;gap:2px}.notification-toolbar-brand strong{font-size:11px;color:#172033}.notification-toolbar-brand small{font-size:9px;color:#94a3b8}.notifications-page .page-head{align-items:flex-end;margin-bottom:18px}.gmail-center{border:1px solid #dfe6ee;background:#fff;box-shadow:0 18px 55px rgba(15,23,42,.07)}.notification-list{min-height:360px}.notification-row.unread .notification-icon{background:#fff7ed;color:#b45309;box-shadow:inset 0 0 0 1px #fed7aa}.notification-row.unread .notification-main-top strong{font-weight:900}.notification-row.read{background:#fff}.notification-row.read:hover{background:#f8fafc}.notification-action.icon-only{width:32px;height:32px;padding:0;justify-content:center}.notification-detail-icon{box-shadow:inset 0 0 0 1px #e8edf3}.gmail-reader-dialog{box-shadow:0 30px 90px rgba(15,23,42,.24);border-color:#dfe6ee}.gmail-reader-toolbar{box-shadow:0 1px 0 rgba(15,23,42,.03)}.gmail-message-body{max-width:100%;margin:0 auto}.mail-reference strong,.mail-info-grid strong{font-variant-numeric:tabular-nums}.mail-section-title{position:relative}.mail-section-title:after{content:"";position:absolute;left:0;right:0;bottom:-1px;height:1px;background:linear-gradient(90deg,transparent,#e8edf3,transparent)}
@media(max-width:900px){.notification-head-stat{display:none}.notification-toolbar-brand{margin-right:0}}
@media(max-width:760px){.notification-toolbar-brand{display:none}.notifications-page .page-head{align-items:stretch}.notification-head-tools{justify-content:stretch}.notification-head-tools .secondary-btn{flex:1}}
