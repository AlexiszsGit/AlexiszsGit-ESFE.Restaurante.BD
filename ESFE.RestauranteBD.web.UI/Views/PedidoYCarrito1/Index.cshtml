@{
    Layout = "_Layout";
    ViewData["Title"] = "Carrito";
}

<section class="page-shell narrow-page">
    <div class="page-head">
        <div>
            <span class="eyebrow">Pedido</span>
            <h2>Tu carrito</h2>
            <p>Revisa cantidades, tipo de pedido y total antes de continuar. Si eliges consumir en restaurante, el sistema te llevará a reservar una mesa antes del pago.</p>
        </div>
        <a asp-controller="GestionDeMenu1" asp-action="Index" class="secondary-btn">← Seguir comprando</a>
    </div>

    <div class="checkout-grid">
        <section class="panel">
            <div class="panel-head">
                <div>
                    <h3>Productos seleccionados</h3>
                    <p id="cartItemSummary">0 productos</p>
                </div>
                <button class="danger-link" onclick="ESFERestaurante.cart.clear()">Vaciar carrito</button>
            </div>

            <div id="cartItems" class="cart-items"></div>
        </section>

        <aside class="panel order-summary">
            <span class="eyebrow">Resumen</span>
            <h3>Total del pedido</h3>

            <div class="summary-row">
                <span>Subtotal</span>
                <strong id="cartSubtotal">$0.00</strong>
            </div>
            <div class="summary-row">
                <span>IVA @AppSettingsStore.Current.TaxPercent%</span>
                <strong id="cartTax">$0.00</strong>
            </div>
            <div class="summary-row total-row">
                <span>Total</span>
                <strong id="cartTotal">$0.00</strong>
            </div>

            <label class="field-label">
                Tipo de pedido
                <select id="orderType" onchange="ESFERestaurante.cart.toggleDeliveryFields()">
                    <option value="Mesa">Consumir en restaurante</option>
                    <option value="Llevar">Para llevar</option>
                    <option value="Domicilio">Pedido a domicilio</option>
                </select>
            </label>
            <div id="deliveryFields" class="delivery-fields hidden">
                <div class="phone-country-field" data-phone-country-field data-default-country="sv">
                    <label class="field-label">
                        País
                        <select data-country-select aria-label="País del teléfono de entrega"></select>
                    </label>
                    <label class="field-label phone-number-label">
                        Teléfono de entrega
                        <input id="deliveryPhone" name="deliveryPhone" type="text" inputmode="tel" autocomplete="tel" data-international-phone required />
                    </label>
                </div>
                <label class="field-label">
                    Dirección de entrega
                    <textarea id="deliveryAddress" rows="3" minlength="5" maxlength="250" placeholder="Dirección completa, colonia, calle y referencia"></textarea>
                </label>
            </div>

            <label class="field-label">
                Notas
                <input id="orderNote" placeholder="Sin cebolla, extra salsa, etc." />
            </label>

            <button id="goPay" class="primary-btn large full" onclick="ESFERestaurante.cart.checkout()">
                Continuar al pago <span>→</span>
            </button>
        </aside>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => ESFERestaurante.cart.init());
    </script>
}