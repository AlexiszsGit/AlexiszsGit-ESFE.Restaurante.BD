
@{
    Layout = "_Layout";
    ViewData["Title"] = "Cocina";
}

@* Contenido principal de la página. *@
<section class="page-shell">
    <div class="page-head">
        <div>
            <span class="eyebrow">Back of house</span>
            <h2>Pantalla de cocina</h2>
            <p>Actualiza cada orden en el flujo de preparación.</p>
        </div>
        <span class="live-badge">
            <i></i> Actualización automática
        </span>
    </div>

    <div class="kanban" id="kitchenBoard"></div>
</section>

@* Scripts necesarios para el funcionamiento de esta vista. *@
@section Scripts {
    @* Datos que la vista expone al JavaScript. *@
    <script>
        document.addEventListener('DOMContentLoaded', () => ESFERestaurante.kitchen.init());
    </script>
}
