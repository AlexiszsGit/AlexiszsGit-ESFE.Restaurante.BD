@{
    Layout = "_Layout";
    ViewData["Title"] = "Pagos";
    var rol = Context.Session.GetString("RolUsuario") ?? "Cliente";
    var esCaja = RoleStore.IsAdministrator(rol) || rol == "Barra";
}

@if (esCaja)
{
<section class="page-shell">
    <div class="page-head payment-staff-head"><div><span class="eyebrow">Caja y cobros</span><h2>Pagos presenciales</h2><p>Busca un pedido por ID, cliente, correo, teléfono o DUI y registra el método con el que acaba de pagar.</p></div><span id="manualPaymentCount" class="result-count">0 pendientes</span></div>
    <div class="payment-staff-grid">
        <section class="panel"><div class="panel-head"><div><span class="eyebrow">Pedidos con saldo</span><h3>Pagos pendientes</h3></div><div class="search-box payment-staff-search"><span>⌕</span><input id="manualPaymentSearch" type="search" placeholder="ID, nombre, correo, teléfono o DUI..." autocomplete="off"></div></div><div id="manualPaymentList" class="manual-payment-list"></div></section>
        <aside class="panel payment-staff-guide"><span class="eyebrow">Flujo de caja</span><h3>Cómo funciona</h3><div class="staff-flow"><div><b>01</b><span>Localiza el pedido.</span></div><div><b>02</b><span>Elige efectivo, tarjeta o transferencia.</span></div><div><b>03</b><span>Valida y confirma el cobro.</span></div><div><b>04</b><span>El pedido pasa a Pagado y se genera la factura.</span></div></div></aside>
    </div>
</section>
<div id="manualPaymentBackdrop" class="modal-backdrop hidden">
    <div class="category-modal admin-modal manual-payment-modal">
        <button id="manualPaymentClose" type="button" class="modal-close">×</button>
        <div class="modal-heading"><span class="eyebrow">Cobro presencial</span><h2>Registrar pago</h2><p id="manualPaymentDetail" class="modal-help"></p></div>
        <div class="manual-payment-summary"><div><span>Pedido</span><strong id="manualPaymentOrderId">—</strong></div><div><span>Cliente</span><strong id="manualPaymentCustomer">—</strong></div><div><span>Total</span><strong id="manualPaymentTotal">$0.00</strong></div></div>
        <div class="payment-methods payment-methods-premium manual-payment-methods"><button type="button" class="payment-method active" data-manual-method="Efectivo" onclick="ESFERestaurante.manualPayments.selectMethod('Efectivo')"><div><strong>Efectivo</strong><small>Caja</small></div></button><button type="button" class="payment-method" data-manual-method="Tarjeta" onclick="ESFERestaurante.manualPayments.selectMethod('Tarjeta')"><div><strong>Tarjeta</strong><small>Validación local</small></div></button><button type="button" class="payment-method" data-manual-method="Transferencia" onclick="ESFERestaurante.manualPayments.selectMethod('Transferencia')"><div><strong>Transferencia</strong><small>Referencia</small></div></button></div>
        <div id="manualPaymentFields" class="manual-payment-fields"></div>
        <div class="modal-actions"><button type="button" class="secondary-btn" onclick="ESFERestaurante.manualPayments.close()">Cancelar</button><button type="button" class="primary-btn" onclick="ESFERestaurante.manualPayments.complete()">Confirmar pago</button></div>
    </div>
</div>
}
else
{
<section class="page-shell narrow-page">
    <div class="page-head">
        <div>
            <span class="eyebrow">Checkout seguro</span>
            <h2>Procesar pago</h2>
            <p>Revisa el pedido, selecciona el método y valida todos los datos antes de confirmar.</p>
            <div id="paymentOrderContext" class="order-context"></div>
        </div>
        <div class="pay-total premium-pay-total">
            <span>Total</span>
            <strong id="paymentTotal">$0.00</strong>
            <small>IVA incluido</small>
        </div>
    </div>

    <div class="checkout-grid payment-layout-premium">
        <section class="panel payment-main-panel">
            <div class="panel-head">
                <div>
                    <span class="eyebrow">Método</span>
                    <h3>¿Cómo deseas pagar?</h3>
                    <p>La tarjeta es una simulación local. No se realiza ningún cargo real.</p>
                </div>
                <div class="payment-security-badge"><span>✓</span> Datos protegidos</div>
            </div>

            <div class="payment-methods payment-methods-premium">
                <button type="button" class="payment-method active" data-method="Efectivo" onclick="ESFERestaurante.payment.selectMethod('Efectivo')">
                    <span class="payment-tab-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="6" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M6 10h5M6 14h8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span>
                    <div><strong>Efectivo</strong><small>Pago en persona</small></div>
                </button>
                <button type="button" class="payment-method" data-method="Tarjeta" onclick="ESFERestaurante.payment.selectMethod('Tarjeta')">
                    <span class="payment-tab-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M3 10h18M7 15h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span>
                    <div><strong>Tarjeta</strong><small>Vista previa y validación</small></div>
                </button>
                <button type="button" class="payment-method" data-method="Transferencia" onclick="ESFERestaurante.payment.selectMethod('Transferencia')">
                    <span class="payment-tab-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 7h14M6 12h12M8 17h8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M4 5h16v14H4z" stroke="currentColor" stroke-width="1.7"/></svg></span>
                    <div><strong>Transferencia</strong><small>Referencia de operación</small></div>
                </button>
            </div>

            <div id="paymentFields" class="payment-fields"></div>

            <div id="cardPreviewWrap" class="card-preview-wrap hidden">
                <div class="card-stage">
                    <div id="cardPreview" class="bank-card bank-card-premium">
                        <div class="bank-card-shine"></div>
                        <div class="bank-card-top">
                            <span>RestauranteBD</span>
                            <span id="cardBrand" class="card-brand-icon" aria-label="Identificador de tarjeta"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M3 10h18M7 15h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span>
                        </div>
                        <div id="cardPreviewNumber" class="bank-card-number">•••• •••• •••• ••••</div>
                        <div class="bank-card-bottom">
                            <div>
                                <small>TITULAR</small>
                                <strong id="cardPreviewName">NOMBRE DEL TITULAR</strong>
                            </div>
                            <div>
                                <small>VENCE</small>
                                <strong id="cardPreviewExpiry">MM/AA</strong>
                            </div>
                        </div>
                        <span id="cardPreviewType" class="card-preview-type">0 dígitos</span>
                    </div>
                </div>
                <p class="card-preview-caption">La tarjeta se actualiza automáticamente mientras completas los campos.</p>
            </div>
        </section>

        <aside class="panel order-summary premium-order-summary">
            <span class="eyebrow">Resumen</span>
            <h3>Tu pedido</h3>
            <div id="paymentItems" class="payment-items"></div>
            <div class="summary-row"><span>Subtotal</span><strong id="paymentSubtotal">$0.00</strong></div>
            <div class="summary-row"><span>IVA @AppSettingsStore.Current.TaxPercent%</span><strong id="paymentTax">$0.00</strong></div>
            <div class="summary-row total-row"><span>Total</span><strong id="paymentTotalAside">$0.00</strong></div>
            <button type="button" class="primary-btn large full payment-confirm-button" onclick="ESFERestaurante.payment.complete()">Confirmar y crear pedido</button>
            <small class="payment-final-note">Antes de confirmar se revisan permisos, carrito, reserva, entrega y datos de pago.</small>
        </aside>
    </div>
</section>
}

@section Scripts {
    @if (esCaja) { <script src="~/js/modules/manual-payments.js" asp-append-version="true"></script> }
    else { <script>document.addEventListener('DOMContentLoaded', () => ESFERestaurante.payment.init());</script> }
}
