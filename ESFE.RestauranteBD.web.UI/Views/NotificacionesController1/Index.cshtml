
@using System.Text.Json
@{
    Layout = "_Layout";
    ViewData["Title"] = "Centro de comunicación";
    var contactosJson = JsonSerializer.Serialize(ViewBag.Contactos ?? new object[0]);
}

@* Contenido principal de la página. *@
<section class="page-shell notifications-page">
    <div id="notificationContacts" data-contacts='@Html.Raw(contactosJson)' hidden></div>

    <div class="mail-app-header">
        <div class="mail-brand-block">
            <div class="mail-brand-icon"><span class="ui-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17.5z" stroke="currentColor" stroke-width="1.7"/><path d="m5 7 7 5 7-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div>
            <div><span class="eyebrow">RestauranteBD</span><h2>Correo y notificaciones</h2><p>Comunicación interna, avisos de operación, pedidos y facturas en un solo lugar.</p></div>
        </div>
        <div class="mail-header-stats"><div><span>No leídas</span><strong id="notificationHeaderUnread">0</strong></div><div><span>Facturas</span><strong id="notificationHeaderInvoices">0</strong></div><button type="button" class="secondary-btn" onclick="ESFERestaurante.notifications.markAllRead()"><span class="action-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Marcar todo leído</button></div>
    </div>

    @* Contenido principal de la página. *@
    <section class="mail-app-shell">
        @* Resumen y acciones secundarias de la vista. *@
        <aside class="mail-sidebar">
            <button type="button" class="compose-btn" onclick="ESFERestaurante.notifications.openCompose()"><span class="ui-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span>Redactar</button>
            @* Navegación y accesos de esta vista. *@
            <nav class="mail-nav" aria-label="Carpetas de correo">
                <button type="button" class="mail-nav-item active" data-notification-filter="all" onclick="ESFERestaurante.notifications.setFilter('all')"><span class="ui-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M4 7.5A2.5 2.5 0 0 1 6.5 5h11A2.5 2.5 0 0 1 20 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 16.5z" stroke="currentColor" stroke-width="1.7"/><path d="m5 7 7 5 7-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span><span>Principal</span></button>
                <button type="button" class="mail-nav-item" data-notification-filter="unread" onclick="ESFERestaurante.notifications.setFilter('unread')"><span class="ui-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M4 7.5A2.5 2.5 0 0 1 6.5 5h11A2.5 2.5 0 0 1 20 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 16.5z" stroke="currentColor" stroke-width="1.7"/><path d="m5 7 7 5 7-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span><span>No leídas</span><b id="mailUnreadSide">0</b></button>
                <button type="button" class="mail-nav-item" data-notification-filter="starred" onclick="ESFERestaurante.notifications.setFilter('starred')"><span class="ui-icon"><svg viewBox="0 0 24 24" fill="none"><path d="m12 4 2.35 4.76 5.25.76-3.8 3.7.9 5.24L12 16l-4.7 2.46.9-5.24-3.8-3.7 5.25-.76L12 4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></span><span>Destacados</span></button>
                <button type="button" class="mail-nav-item" data-notification-filter="sent" onclick="ESFERestaurante.notifications.setFilter('sent')"><span class="ui-icon"><svg viewBox="0 0 24 24" fill="none"><path d="m4 5 16 7-16 7 3.3-7z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M7 12h9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span><span>Enviados</span></button>
                <button type="button" class="mail-nav-item" data-notification-filter="invoice" onclick="ESFERestaurante.notifications.setFilter('invoice')"><span class="ui-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M6 3.5h9l3 3V20H6z" stroke="currentColor" stroke-width="1.8"/><path d="M14 3.5V7h4M8.5 11h7M8.5 15h7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span><span>Facturas</span></button>
                <button type="button" class="mail-nav-item" data-notification-filter="archive" onclick="ESFERestaurante.notifications.setFilter('archive')"><span class="ui-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M4 7h16v12H4zM3 4h18v3H3z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M9 11h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span><span>Archivados</span></button>
            </nav>
            <div class="mail-sidebar-foot"><span class="ui-icon"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.7"/><path d="M12 10v6M12 7.5v.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span><div><strong>Centro seguro</strong><p>Usa este canal para comunicarte con las áreas del restaurante.</p></div></div>
        </aside>

        @* Contenido principal de la página. *@
        <section class="mail-main-area">
            @* Encabezado de la página con título y acciones principales. *@
            <header class="mail-toolbar">
                <div class="mail-toolbar-tabs"><button type="button" class="filter-chip active" data-notification-filter="all" onclick="ESFERestaurante.notifications.setFilter('all')">Principal</button><button type="button" class="filter-chip" data-notification-filter="unread" onclick="ESFERestaurante.notifications.setFilter('unread')">No leídas</button><button type="button" class="filter-chip" data-notification-filter="invoice" onclick="ESFERestaurante.notifications.setFilter('invoice')">Facturas</button></div>
                <label class="mail-search"><span class="ui-icon"><svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span><input type="search" placeholder="Buscar correo y notificaciones" oninput="ESFERestaurante.notifications.searchFor(this.value)" /></label>
            </header>
            <div class="mail-list-head"><div><strong>Bandeja</strong><span>Mensajes ordenados por fecha</span></div><div class="mail-list-tools"><button type="button" id="notificationSelectMode" class="secondary-btn small" onclick="ESFERestaurante.notifications.toggleSelectionMode()">Seleccionar</button><button type="button" class="icon-btn" aria-label="Actualizar" onclick="ESFERestaurante.notifications.render()"><span class="ui-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M19 8a7.5 7.5 0 0 0-13.3-1.6L4 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 4.5V8h3.5M5 16a7.5 7.5 0 0 0 13.3 1.6L20 16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><path d="M20 19.5V16h-3.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span></button></div></div>
            <div id="notificationSelectionToolbar" class="notification-selection-toolbar" hidden><label class="notification-select-all"><input id="notificationSelectAll" type="checkbox" onchange="ESFERestaurante.notifications.toggleSelectAll(this.checked)" /><span>Seleccionar todo</span></label><span id="notificationSelectionCount">0 seleccionadas</span><div><button id="notificationDeleteSelected" type="button" class="danger-btn small" disabled onclick="ESFERestaurante.notifications.deleteSelected()">Eliminar</button><button id="notificationArchiveSelected" type="button" class="secondary-btn small" disabled onclick="ESFERestaurante.notifications.archiveSelected()">Archivar</button></div></div>
            <div id="notificationList" class="mail-list"></div>
        </section>
    </section>
</section>

<div id="notificationDetailModal" class="notification-detail-modal gmail-reader" role="dialog" aria-modal="true" aria-labelledby="notificationDetailTitle">
  <article class="notification-detail-dialog gmail-reader-dialog">
    @* Encabezado de la página con título y acciones principales. *@
    <header class="gmail-reader-toolbar"><button type="button" class="notification-detail-close" aria-label="Cerrar" onclick="ESFERestaurante.notifications.close()"><span class="ui-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M7 7 17 17M17 7 7 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span></button><div class="gmail-reader-toolbar-actions"><button type="button" class="icon-btn" data-notification-detail-star aria-label="Destacar"><span class="ui-icon"><svg viewBox="0 0 24 24" fill="none"><path d="m12 4 2.35 4.76 5.25.76-3.8 3.7.9 5.24L12 16l-4.7 2.46.9-5.24-3.8-3.7 5.25-.76L12 4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></span></button></div></header>
    <div class="gmail-reader-body"><div class="gmail-reader-heading"><div class="notification-detail-icon"><span class="ui-icon" data-notification-detail-icon></span></div><div class="gmail-reader-subject-wrap"><h3 id="notificationDetailTitle" data-notification-detail-title>Mensaje</h3><div class="gmail-labels"><span class="gmail-label">RestauranteBD</span><span class="gmail-label soft" data-notification-detail-type>Mensaje</span></div></div></div>
      <div class="gmail-sender-row"><div class="gmail-sender-avatar" data-notification-detail-avatar>R</div><div class="gmail-sender-copy"><strong data-notification-detail-sender>RestauranteBD</strong><span>&lt;<span data-notification-detail-sender-email>notificaciones@restaurantebd.local</span>&gt;</span><button type="button" class="gmail-recipient" data-notification-detail-recipient>para mí</button></div><time data-notification-detail-date></time></div>
      <div class="gmail-message-body" data-notification-detail-body></div></div>
    <footer class="gmail-reader-footer"><button type="button" class="secondary-btn" data-notification-detail-reply><span class="action-icon"><svg viewBox="0 0 24 24" fill="none"><path d="m10 8-6 4 6 4v-3c5.5 0 8 1 10 4-1-5-3.5-8-10-8z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg></span>Responder</button><button type="button" class="secondary-btn" data-notification-detail-action></button><button type="button" class="danger-btn" data-notification-detail-delete>Eliminar</button><button type="button" class="primary-btn" onclick="ESFERestaurante.notifications.close()"><span class="action-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M7 7 17 17M17 7 7 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>Cerrar</button></footer>
  </article>
</div>

<div id="composeMailModal" class="notification-detail-modal compose-modal" role="dialog" aria-modal="true" aria-labelledby="composeTitle">
  <article class="compose-dialog">
    @* Encabezado de la página con título y acciones principales. *@
    <header class="compose-head"><div><span class="eyebrow">Nuevo mensaje</span><h3 id="composeTitle">Redactar correo</h3></div><button type="button" class="notification-detail-close" aria-label="Cerrar" onclick="ESFERestaurante.notifications.closeCompose()"><span class="ui-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M7 7 17 17M17 7 7 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span></button></header>
    <div class="compose-body gmail-compose-body">
      <div class="compose-account-row">
        <span class="compose-row-icon"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.2" stroke="currentColor" stroke-width="1.7"/><path d="M5.5 19c.8-3.2 3-4.8 6.5-4.8s5.7 1.6 6.5 4.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span>
        <span class="compose-row-label">De</span>
        <div class="compose-from-block"><strong id="composeFromName">Tu cuenta</strong><span id="composeFromEmail">cuenta@restaurantebd.local</span></div>
        <span class="compose-from-badge">Cuenta activa</span>
      </div>

      <div class="compose-recipient-row">
        <div class="compose-recipient-main">
          <span class="compose-row-label">Para</span>
          <input id="composeRecipient" type="email" inputmode="email" autocomplete="email" maxlength="254" placeholder="correo@ejemplo.com" aria-label="Destinatario" />
        </div>
        <div class="compose-extra-links"><button type="button" id="composeCcToggle">Cc</button><button type="button" id="composeBccToggle">Cco</button></div>
      </div>
      <div id="composeCcRow" class="compose-recipient-row compose-optional-row" hidden><span class="compose-row-label">Cc</span><input id="composeCc" type="text" maxlength="500" placeholder="Correos separados por coma" /></div>
      <div id="composeBccRow" class="compose-recipient-row compose-optional-row" hidden><span class="compose-row-label">Cco</span><input id="composeBcc" type="text" maxlength="500" placeholder="Correos separados por coma" /></div>
      <small id="composeRecipientHint" class="compose-global-hint">Escribe directamente el correo electrónico del destinatario. Para Cc y Cco puedes escribir varios correos separados por comas.</small>

      <label class="compose-field compose-subject-field"><span>Asunto</span><input id="composeSubject" type="text" maxlength="120" placeholder="Asunto" /></label>
      <div class="compose-message-wrap">
        <label class="compose-field compose-message-field"><span class="visually-hidden">Mensaje</span><textarea id="composeMessage" maxlength="5000" placeholder="Escribe tu mensaje..."></textarea></label>
        <div class="compose-tools" aria-label="Herramientas del mensaje"><button type="button" aria-label="Formato" title="Formato" onclick="ESFERestaurante.notifications.toggleFormatTools()"><svg viewBox="0 0 24 24" fill="none"><path d="M6 5h12M9 5v14M15 5c-1.2 0-2.2 1-2.2 2.2S13.8 9.4 15 9.4h.2c1.4 0 2.5 1.1 2.5 2.5V14c0 1.7-1.3 3-3 3h-2.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button><button type="button" aria-label="Adjuntar archivo" title="Adjuntar archivo" onclick="document.getElementById('composeAttachmentInput')?.click()"><svg viewBox="0 0 24 24" fill="none"><path d="m8.5 12.5 5.8-5.8a3.2 3.2 0 0 1 4.5 4.5l-7.1 7.1a4.3 4.3 0 0 1-6.1-6.1l7-7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></button><span>Adjuntos: hasta 5 archivos · 200 MB c/u · 200 MB por mensaje.</span></div><div id="composeFormatPanel" class="compose-format-panel" aria-label="Formato"><button type="button" title="Negrita" onclick="ESFERestaurante.notifications.insertFormat('bold')"><strong>B</strong></button><button type="button" title="Cursiva" onclick="ESFERestaurante.notifications.insertFormat('italic')"><em>I</em></button><button type="button" title="Cita" onclick="ESFERestaurante.notifications.insertFormat('quote')">❯</button><button type="button" title="Lista" onclick="ESFERestaurante.notifications.insertFormat('list')">•</button></div><div id="composeAttachments" class="compose-attachments" hidden></div><input id="composeAttachmentInput" type="file" multiple hidden />
      </div>
    </div>
    <footer class="compose-footer gmail-compose-footer"><span id="composeDraftStatus"></span><div><button type="button" class="secondary-btn" onclick="ESFERestaurante.notifications.closeCompose()">Descartar</button><button type="button" class="primary-btn" onclick="ESFERestaurante.notifications.sendCompose()"><span class="action-icon"><svg viewBox="0 0 24 24" fill="none"><path d="m4 5 16 7-16 7 3.3-7z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M7 12h9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span>Enviar</button></div></footer>
  </article>
</div>

@* Scripts necesarios para el funcionamiento de esta vista. *@
@section Scripts {
@* Datos que la vista expone al JavaScript. *@
<script>
document.addEventListener('DOMContentLoaded',()=>{try{ESFERestaurante.notifications.init();}catch(error){console.error('No se pudo inicializar el centro de notificaciones.',error);const list=document.getElementById('notificationList');if(list)list.innerHTML='<div class="mail-empty"><strong>No se pudieron cargar las notificaciones.</strong><p>El resto de la aplicación sigue disponible. Actualiza esta pantalla para intentarlo de nuevo.</p></div>';}const to=document.getElementById('composeRecipient');to?.addEventListener('input',()=>ESFERestaurante.notifications.updateComposeState());document.getElementById('composeCcToggle')?.addEventListener('click',()=>{const row=document.getElementById('composeCcRow');if(row){row.hidden=!row.hidden; if(!row.hidden)document.getElementById('composeCc')?.focus();}});document.getElementById('composeBccToggle')?.addEventListener('click',()=>{const row=document.getElementById('composeBccRow');if(row){row.hidden=!row.hidden; if(!row.hidden)document.getElementById('composeBcc')?.focus();}});document.addEventListener('keydown',e=>{if(e.key==='Escape'){ESFERestaurante.notifications.close();ESFERestaurante.notifications.closeCompose();}});document.getElementById('notificationDetailModal')?.addEventListener('click',e=>{if(e.target.id==='notificationDetailModal')ESFERestaurante.notifications.close();});document.getElementById('composeMailModal')?.addEventListener('click',e=>{if(e.target.id==='composeMailModal')ESFERestaurante.notifications.closeCompose();});});
</script>
}
