@{
    Layout = "_Layout";
    ViewData["Title"] = "Notificaciones";
}

<section class="page-shell notifications-page">
    <div class="page-head">
        <div>
            <span class="eyebrow">Centro de comunicación</span>
            <h2>Bandeja de notificaciones</h2>
            <p>Un solo centro para pedidos, pagos, operaciones, entregas, reservas y facturas.</p>
        </div>
        <div class="notification-head-tools">
            <div class="notification-head-stat"><span class="ui-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span><div><span>No leídas</span><strong id="notificationHeaderUnread">0</strong></div></div>
            <div class="notification-head-stat"><span class="ui-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M6 3.5h9l3 3V20H6z" stroke="currentColor" stroke-width="1.8"/><path d="M14 3.5V7h4M8.5 11h7M8.5 15h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span><div><span>Facturas</span><strong id="notificationHeaderInvoices">0</strong></div></div>
            <button class="secondary-btn" onclick="ESFERestaurante.notifications.markAllRead()"><span class="action-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12.5 9.5 17 19 7.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Marcar todas como leídas</button>
    </div>

    <section class="panel notification-center gmail-center">
        <div class="notification-toolbar">
            <div class="notification-toolbar-brand"><span class="ui-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><rect x="3.5" y="5" width="17" height="14" rx="2.5" stroke="currentColor" stroke-width="1.8"/><path d="m5 7 7 5 7-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span><div><strong>Bandeja</strong><small>Actividad del sistema</small></div></div>
            <div class="notification-toolbar-tabs">
                <button type="button" class="filter-chip active" data-notification-filter="all" onclick="ESFERestaurante.notifications.setFilter('all')">Principal</button>
                <button type="button" class="filter-chip" data-notification-filter="unread" onclick="ESFERestaurante.notifications.setFilter('unread')">No leídas</button>
                <button type="button" class="filter-chip" data-notification-filter="invoice" onclick="ESFERestaurante.notifications.setFilter('invoice')">Facturas</button>
            </div>
            <label class="search-box small notification-search">
                <span class="ui-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
                <input type="search" placeholder="Buscar en notificaciones..." oninput="ESFERestaurante.notifications.searchFor(this.value)" />
            </label>
        </div>
        <div class="notification-list-head"><span>Mensajes</span><span>Más recientes primero</span></div>
        <div id="notificationList" class="notification-list"></div>
    </section>
</section>

<div id="notificationDetailModal" class="notification-detail-modal gmail-reader" role="dialog" aria-modal="true" aria-labelledby="notificationDetailTitle">
  <article class="notification-detail-dialog gmail-reader-dialog">
    <header class="gmail-reader-toolbar">
      <button type="button" class="notification-detail-close" aria-label="Cerrar" onclick="ESFERestaurante.notifications.close()">
        <span class="ui-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M7 7 17 17M17 7 7 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
      </button>
      <div class="gmail-reader-toolbar-actions">
        <button type="button" class="icon-btn" title="Marcar como leída" aria-label="Marcar como leída"><span class="ui-icon"><svg viewBox="0 0 24 24" fill="none"><path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span></button>
      </div>
    </header>

    <div class="gmail-reader-body">
      <div class="gmail-reader-heading">
        <div class="notification-detail-icon"><span class="ui-icon" data-notification-detail-icon aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span></div>
        <div class="gmail-reader-subject-wrap">
          <h3 id="notificationDetailTitle" data-notification-detail-title>Notificación</h3>
          <div class="gmail-labels"><span class="gmail-label">RestauranteBD</span><span class="gmail-label soft" data-notification-detail-type>Mensaje</span></div>
        </div>
      </div>

      <div class="gmail-sender-row">
        <div class="gmail-sender-avatar" data-notification-detail-avatar>R</div>
        <div class="gmail-sender-copy">
          <strong data-notification-detail-sender>RestauranteBD</strong>
          <span>&lt;<span data-notification-detail-sender-email>notificaciones@restaurantebd.local</span>&gt;</span>
          <button type="button" class="gmail-recipient" data-notification-detail-recipient>para mí</button>
        </div>
        <time data-notification-detail-date></time>
        <button type="button" class="icon-btn" aria-label="Destacar" data-notification-detail-star><span class="ui-icon"><svg viewBox="0 0 24 24" fill="none"><path d="m12 4 2.35 4.76 5.25.76-3.8 3.7.9 5.24L12 16l-4.7 2.46.9-5.24-3.8-3.7 5.25-.76L12 4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></span></button>
      </div>

      <div class="gmail-message-body" data-notification-detail-body></div>
    </div>

    <footer class="gmail-reader-footer">
      <button type="button" class="secondary-btn" data-notification-detail-action></button>
      <button type="button" class="primary-btn" onclick="ESFERestaurante.notifications.close()"><span class="action-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M7 7 17 17M17 7 7 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>Cerrar</button>
    </footer>
  </article>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => ESFERestaurante.notifications.init());
    </script>
}
