
@using ESFE.RestauranteBD.web.UI.Models
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery AntiForgery

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();

    var mostrarApp = controller != "IniciarSesion1";

    var settings = AppSettingsStore.Current;

    var rol = Context.Session.GetString("RolUsuario") ?? "Cliente";

    var esDueno = RoleStore.IsAdministrator(rol);
    var esCocina = rol == "Cocina";
    var esBarra = rol == "Barra";

    var usuario = Context.Session.GetString("UsuarioLogueado") ?? string.Empty;

    var autenticado = !string.IsNullOrWhiteSpace(usuario);

    var nombreUsuario =
        Context.Session.GetString("NombreUsuario")
        ?? (esDueno ? "Dueño" : "Cliente");

    var telefonoUsuario =
        Context.Session.GetString("TelefonoUsuario") ?? "";

    var duiUsuario =
        Context.Session.GetString("DuiUsuario") ?? "";

    var direccionUsuario =
        Context.Session.GetString("DireccionUsuario") ?? "";

    var usuarioCuenta =
        autenticado &&
        UserStore.TryGet(usuario, out var cuentaEncontrada)
            ? cuentaEncontrada
            : null;

    var fotoPerfil =
        usuarioCuenta?.ProfilePhotoData ?? "";

    var inicialPerfil =
        string.IsNullOrWhiteSpace(nombreUsuario)
            ? "U"
            : nombreUsuario.Trim()[0].ToString().ToUpperInvariant();

    var etiquetaRol =
        esDueno
            ? "Administrador"
            : RoleStore.DisplayName(rol);
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="theme-color"
          content="@settings.PrimaryColor" />

    <meta name="request-verification-token"
          content="@AntiForgery.GetAndStoreTokens(Context).RequestToken" />

    <title>
        @ViewData["Title"] - RestauranteBD
    </title>

    <link rel="stylesheet"
          href="~/css/tailwind.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/premium.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/final-polish.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/responsive-final.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/ultra-professional.css"
          asp-append-version="true" />
    <link rel="stylesheet" href="~/css/final-signature.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/professional-refinement.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/settings-pro.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/international-v9.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/settings-signature.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dark-mode-final.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-unified.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dark-mode-final-overrides.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dark-mode-global-final.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dark-mode-definitive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dark-mode-no-white.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mobile-orders-cart-final.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/final-experience.css" asp-append-version="true" />

    <script>
        // Aplica el tema antes de pintar la página para evitar un destello claro/oscuro.
        (() => {
            try {
                const saved = localStorage.getItem('restaurantebd.theme') || 'system';
                const dark = saved === 'dark' || (saved === 'system' && window.matchMedia?.('(prefers-color-scheme: dark)').matches);
                document.documentElement.dataset.theme = dark ? 'dark' : 'light';
            } catch {
                document.documentElement.dataset.theme = 'light';
            }
        })();
    </script>

</head>

<body class="app-body @(settings.CompactMode ? "compact-mode" : "")"

