                                      stroke="currentColor"
                                      stroke-width="1.8"
                                      stroke-linejoin="round" />

                                <path d="M7.5 12H20"
                                      stroke="currentColor"
                                      stroke-width="1.8"
                                      stroke-linecap="round" />

                            </svg>

                        </span>

                    </button>

                </form>

            </section>

            <!-- BOTÓN FLOTANTE DEL CHAT -->

            <button type="button"
                    class="chat-launcher"
                    onclick="ESFERestaurante.chat.toggle(true)"
                    aria-label="Abrir asistente">

                <svg viewBox="0 0 24 24" fill="none">

                    <path d="M7 10.5a5 5 0 0 1 10 0v3.1a3.9 3.9 0 0 1-3.9 3.9H11l-2.8 2v-2.8A4 4 0 0 1 5 12.8v-1.4a5 5 0 0 1 2-0.9"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round" />

                    <path d="M9 12h.01M15 12h.01"
                          stroke="currentColor"
                          stroke-width="2.2"
                          stroke-linecap="round" />

                </svg>

            </button>

            <div id="toast-container"
                 class="toast-container">
            </div>
        }
    }
    else
    {
        @RenderBody()
    }

    @* Scripts principales de la aplicación. *@

    <script src="~/js/db-bridge.js"
            asp-append-version="true"></script>

    <script src="~/js/modules/localization.js" asp-append-version="true"></script>

    <script src="~/js/modules/currency.js" asp-append-version="true"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <script src="~/js/modules/local-orders.js"
            asp-append-version="true"></script>

    <script src="~/js/modules/validation.js"
            asp-append-version="true"></script>

    <script src="~/js/modules/chatbot.js"
            asp-append-version="true"></script>

    <script src="~/js/modules/payment.js"
            asp-append-version="true"></script>

    <script src="~/js/modules/cart.js"
            asp-append-version="true"></script>

    <script src="~/js/modules/settings.js" asp-append-version="true"></script>
    <script src="~/js/international-v9.js" asp-append-version="true"></script>
    <script src="~/js/modules/dark-mode-audit.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
