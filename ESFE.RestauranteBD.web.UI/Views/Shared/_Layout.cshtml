        --accent:@settings.PrimaryColor;
        --accent2:@settings.PrimaryDarkColor;
        --accent-soft:@settings.PrimarySoftColor;
        --bg:@settings.BackgroundColor;
        --white:@settings.SurfaceColor;
        --ink:@settings.TextColor;
        --muted:@settings.MutedColor;
        --line:@settings.LineColor;
        --sidebar:@settings.SidebarColor;
        --secondary:@settings.SecondaryColor;
        --success:@settings.SuccessColor;
        --danger:@settings.DangerColor;
        --warning:@settings.WarningColor;
      "

      data-role="@(autenticado ? rol : "Publico")"

      data-auth="@autenticado"

      data-user="@usuario"

      data-user-name="@nombreUsuario"

      data-phone="@telefonoUsuario"

      data-dui="@duiUsuario"

      data-address="@direccionUsuario"

      data-profile-photo="@fotoPerfil"

      data-local-orders="@((esDueno || rol == "Barra") ? "true" : "false")"

      data-tax="@settings.TaxPercent"

      data-currency="@settings.CurrencySymbol"

      data-opening="@settings.OpeningTime"

      data-closing="@settings.ClosingTime"

      data-settings-animations="@(settings.EnableAnimations ? "true" : "false")"

      data-settings-reduce-shadows="@(settings.ReduceShadows ? "true" : "false")"

      data-show-images="@(settings.ShowProductImages ? "true" : "false")"

      data-demo-card="@(settings.DemoCardPayments ? "true" : "false")"

      data-notifications="@(RoleStore.CanAccess(rol, RoleStore.Notifications) ? "true" : "false")"

      data-role-permissions='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(RoleStore.Get(rol)?.Permissions ?? new List<string>()))'

      data-page-controller="@controller"

      data-page-action="@ViewContext.RouteData.Values["action"]">

