
@* Modelo: define los datos que recibe la vista. *@
@model ESFE.RestauranteBD.web.UI.Models.UserAccount
@{
    Layout = "_Layout";
    ViewData["Title"] = "Mi perfil";
    var displayRole = RoleStore.IsAdministrator(Model.Rol) ? "Administrador" : Model.Rol;
}

@* Contenido principal de la página. *@
<section class="page-shell narrow-page">
    <div class="page-head">
        <div>
            <span class="eyebrow">Cuenta</span>
            <h2>Mi perfil</h2>
            <p>Tu información personal y de contacto. El rol lo administra exclusivamente el administrador.</p>
        </div>
        <span class="role-badge role-@Model.Rol.ToLowerInvariant()">@displayRole</span>
    </div>

    @if (TempData["ProfileError"] != null)
    {
        <div class="alert-error">@TempData["ProfileError"]</div>
    }

    @if (TempData["ProfileSuccess"] != null)
    {
        <div class="alert-success">@TempData["ProfileSuccess"]</div>
    }

    <div class="profile-layout">
        @* Contenido principal de la página. *@
        <section class="panel profile-summary-panel">
            <div class="profile-hero profile-hero-large">
                <div class="profile-avatar profile-avatar-photo">
                    @if (!string.IsNullOrWhiteSpace(Model.ProfilePhotoData))
                    {
                        <img src="@Model.ProfilePhotoData" alt="Foto de perfil de @Model.Nombre" />
                    }
                    else
                    {
                        <span>@Model.Nombre.FirstOrDefault().ToString().ToUpperInvariant()</span>
                    }
                </div>
                <div>
                    <span class="eyebrow">Cuenta activa</span>
                    <h3>@Model.Nombre</h3>
                    <p>@Model.Email</p>
                </div>
            </div>

            <div class="profile-photo-manager">
                <div>
                    <span class="eyebrow">Imagen de perfil</span>
                    <strong>Personaliza tu cuenta</strong>
                    <p>JPG, PNG o WebP · máximo 2 MB. La imagen se guarda dentro de tu perfil.</p>
                </div>
                <div class="profile-photo-actions">
                    @* Campos y controles para capturar información. *@
                    <form asp-action="ActualizarFoto" method="post" enctype="multipart/form-data" class="profile-photo-form">
                        @Html.AntiForgeryToken()
                        <label class="secondary-btn small profile-photo-picker">
                            <span class="action-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 17.5V6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17.5Z" stroke="currentColor" stroke-width="1.7"/><circle cx="8.5" cy="9" r="1.5" stroke="currentColor" stroke-width="1.5"/><path d="m5 17 4.5-4.5 3 3 2.5-2.5L19 17" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg></span>
                            Cambiar foto
                            <input name="foto" type="file" accept="image/jpeg,image/png,image/webp" hidden onchange="this.form.submit()" />
                        </label>
                    </form>
                    @if (!string.IsNullOrWhiteSpace(Model.ProfilePhotoData))
                    {
                        @* Campos y controles para capturar información. *@
                        <form asp-action="EliminarFoto" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="danger-btn small">Eliminar foto</button>
                        </form>
                    }
                </div>
            </div>

            <div class="profile-data">
                <div><span>Nombre</span><strong>@Model.Nombre</strong></div>
                <div><span>Correo</span><strong>@Model.Email</strong></div>
                <div><span>DUI</span><strong>@Model.Dui</strong></div>
                <div><span>Teléfono</span><strong>@Model.Telefono</strong></div>
                <div class="profile-data-wide"><span>Dirección</span><strong>@Model.Direccion</strong></div>
                <div><span>Cuenta creada</span><strong>@Model.CreadoEn.ToLocalTime().ToString("dd/MM/yyyy")</strong></div>
            </div>

            <div class="profile-protection-note">
                <span>Seguridad de la cuenta</span>
                <strong>El rol no se puede cambiar desde este perfil.</strong>
                <p>Los permisos se determinan en el servidor según el rol asignado por el administrador.</p>
            </div>
        </section>

        @* Contenido principal de la página. *@
        <section class="panel">
            <span class="eyebrow">Editar información</span>
            <h3>Datos personales</h3>
            @* Campos y controles para capturar información. *@
            <form asp-action="Actualizar" method="post" class="form-stack profile-edit-form">
                @Html.AntiForgeryToken()

                <label class="field-label">
                    Nombre completo
                    <input name="nombre" value="@Model.Nombre" data-letters-only minlength="3" maxlength="80" required />
                </label>

                <label class="field-label">
                    Correo electrónico
                    <input value="@Model.Email" type="email" readonly aria-readonly="true" />
                    <small class="field-hint">El correo identifica la cuenta y no se cambia desde aquí.</small>
                </label>

                <label class="field-label">
                    DUI
                    <input name="dui" value="@Model.Dui" data-dui inputmode="numeric" maxlength="10" pattern="[0-9]{8}-[0-9]" required />
                </label>

                <div class="phone-country-field" data-phone-country-field data-default-country="sv">
                    <label class="field-label">
                        País
                        <select data-country-select aria-label="País del teléfono"></select>
                    </label>
                    <label class="field-label phone-number-label">
                        Teléfono
                        <input name="telefono" value="@Model.Telefono" data-international-phone inputmode="tel" autocomplete="tel" required />
                    </label>
                </div>

                <label class="field-label">
                    Dirección
                    <textarea name="direccion" minlength="5" maxlength="250" rows="4" required>@Model.Direccion</textarea>
                </label>

                <button class="primary-btn large full" type="submit">Guardar cambios</button>
            </form>
        </section>
    </div>
</section>

@* Scripts necesarios para el funcionamiento de esta vista. *@
@section Scripts {
    @* Datos que la vista expone al JavaScript. *@
    <script src="~/js/modules/validation.js" asp-append-version="true"></script>
}
