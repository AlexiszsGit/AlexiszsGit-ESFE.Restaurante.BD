@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
    var activeTab = ViewBag.ActiveTab as string ?? "login";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f172a" />
    <title>Iniciar sesión - RestauranteBD</title>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">
    <div class="login-bg-shape shape-a"></div><div class="login-bg-shape shape-b"></div>
    <div class="login-wrap">
        <div class="login-brand">
            <div class="login-logo">
                <img src="~/images/logo.png" alt="Logo del restaurante" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
                <span>R</span>
            </div>
            <span class="eyebrow">RestauranteBD</span>
            <h1>RestauranteBD</h1>
            <p>Gestión, pedidos y atención en un solo lugar.</p>
        </div>
        <div class="login-card">
            <div class="login-tabs" role="tablist" aria-label="Acceso a RestauranteBD">
                <button type="button" class="login-tab @(activeTab == "login" ? "active" : "")" onclick="showLoginTab('login')">Iniciar sesión</button>
                <button type="button" class="login-tab @(activeTab == "register" ? "active" : "")" onclick="showLoginTab('register')">Crear cuenta</button>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert-error">@ViewBag.Error</div>
            }
            @if (ViewBag.Success != null)
            {
                <div class="alert-success">@ViewBag.Success</div>
            }

            <div id="loginPanel" class="login-panel @(activeTab == "login" ? "" : "hidden")">
                <div class="login-heading"><div><span class="eyebrow">Acceso seguro</span><h2>Bienvenido</h2><p>Ingresa con tu cuenta para continuar.</p></div><span class="security-badge">● Activo</span></div>
                <form asp-controller="IniciarSesion1" asp-action="Login" method="post" class="login-form">
                    <label>Correo electrónico<input name="email" type="email" value="@(ViewBag.Email ?? "")" autocomplete="username" placeholder="admin@restaurante.com" required /></label>
                    <label>Contraseña<div class="password-field"><input id="password" name="password" type="password" autocomplete="current-password" placeholder="Tu contraseña" required /><button type="button" onclick="togglePassword('password')">◉</button></div></label>
                    <div class="login-options"><label class="check-row"><input type="checkbox" name="remember" value="true" />Recordarme</label><span>Acceso protegido</span></div>
                    <button class="primary-btn large" type="submit">Ingresar al sistema <span>→</span></button>
                </form>
                <div class="demo-access"><strong>Acceso demo</strong><span>admin@restaurante.com · 123</span><small>Cliente demo: cliente@restaurante.com · 1234</small></div>
            </div>

            <div id="registerPanel" class="login-panel @(activeTab == "register" ? "" : "hidden")">
                <div class="login-heading"><div><span class="eyebrow">Nuevo cliente</span><h2>Crear cuenta</h2><p>Regístrate para guardar tus pedidos y acceder al sistema.</p></div></div>
                <form asp-controller="IniciarSesion1" asp-action="Registrar" method="post" class="login-form">
                    <label>Nombre completo<input name="nombre" type="text" value="@(ViewBag.RegisterName ?? "")" autocomplete="name" placeholder="Tu nombre completo" minlength="3" required /></label>
                    <label>Correo electrónico<input name="email" type="email" value="@(ViewBag.RegisterEmail ?? "")" autocomplete="email" placeholder="correo@ejemplo.com" required /></label>
                    <label>Teléfono <span class="muted-text">(opcional)</span><input name="telefono" type="tel" value="@(ViewBag.RegisterPhone ?? "")" autocomplete="tel" placeholder="0000-0000" inputmode="tel" /></label>
                    <label>Contraseña<div class="password-field"><input id="registerPassword" name="password" type="password" autocomplete="new-password" placeholder="Mínimo 8 caracteres" minlength="8" required /><button type="button" onclick="togglePassword('registerPassword')">◉</button></div></label>
                    <label>Confirmar contraseña<input name="confirmPassword" type="password" autocomplete="new-password" placeholder="Repite tu contraseña" minlength="8" required /></label>
                    <small class="form-help">Usa una contraseña con mayúscula, minúscula y número.</small>
                    <button class="primary-btn large" type="submit">Crear mi cuenta <span>✓</span></button>
                </form>
            </div>
        </div>
        <p class="login-footer">RestauranteBD · Sistema de gestión gastronómica</p>
    </div>
<script>
function togglePassword(id){const i=document.getElementById(id);if(i)i.type=i.type==='password'?'text':'password';}
function showLoginTab(tab){document.getElementById('loginPanel').classList.toggle('hidden',tab!=='login');document.getElementById('registerPanel').classList.toggle('hidden',tab!=='register');document.querySelectorAll('.login-tab').forEach((b,i)=>b.classList.toggle('active',(tab==='login'&&i===0)||(tab==='register'&&i===1)));}
const user='@TempData["UsuarioLogueado"]';if(user){localStorage.setItem('usuarioLogueado',user);}
</script>
</body>
</html>