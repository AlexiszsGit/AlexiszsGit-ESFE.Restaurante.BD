@{
    var appSettings = AppSettingsStore.Current;
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;

    var activeTab = ViewBag.ActiveTab as string ?? "login";
    var selectedCountry = (ViewBag.RegisterCountryCode as string ?? "sv").Trim().TrimStart('+');
    var verificationEmail = ViewBag.VerificationEmail as string ?? "";
    var recoveryEmail = ViewBag.RecoveryEmail as string ?? "";

    var flowEmailDone = activeTab is "verify" or "resetCode" or "resetPassword";
    var flowCodeActive = activeTab is "verify" or "resetCode";
    var flowCodeDone = activeTab == "resetPassword";
    var flowPasswordActive = activeTab == "resetPassword";

    var countries = new[]
    {
        (Id:"sv",Name:"El Salvador",Code:"503"),(Id:"gt",Name:"Guatemala",Code:"502"),(Id:"hn",Name:"Honduras",Code:"504"),(Id:"ni",Name:"Nicaragua",Code:"505"),(Id:"cr",Name:"Costa Rica",Code:"506"),(Id:"pa",Name:"Panamá",Code:"507"),
        (Id:"mx",Name:"México",Code:"52"),(Id:"us",Name:"Estados Unidos",Code:"1"),(Id:"ca",Name:"Canadá",Code:"1"),(Id:"do",Name:"República Dominicana",Code:"1"),(Id:"pr",Name:"Puerto Rico",Code:"1"),(Id:"es",Name:"España",Code:"34"),
        (Id:"ar",Name:"Argentina",Code:"54"),(Id:"bo",Name:"Bolivia",Code:"591"),(Id:"br",Name:"Brasil",Code:"55"),(Id:"cl",Name:"Chile",Code:"56"),(Id:"co",Name:"Colombia",Code:"57"),(Id:"ec",Name:"Ecuador",Code:"593"),
        (Id:"pe",Name:"Perú",Code:"51"),(Id:"py",Name:"Paraguay",Code:"595"),(Id:"uy",Name:"Uruguay",Code:"598"),(Id:"ve",Name:"Venezuela",Code:"58"),(Id:"cu",Name:"Cuba",Code:"53"),(Id:"gb",Name:"Reino Unido",Code:"44"),
        (Id:"fr",Name:"Francia",Code:"33"),(Id:"de",Name:"Alemania",Code:"49"),(Id:"it",Name:"Italia",Code:"39"),(Id:"jp",Name:"Japón",Code:"81"),(Id:"cn",Name:"China",Code:"86"),(Id:"in",Name:"India",Code:"91"),
        (Id:"au",Name:"Australia",Code:"61"),(Id:"nz",Name:"Nueva Zelanda",Code:"64"),(Id:"za",Name:"Sudáfrica",Code:"27"),(Id:"kr",Name:"Corea del Sur",Code:"82")
    };
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="@appSettings.PrimaryColor" />
    <title>Iniciar sesión - @appSettings.RestaurantName</title>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/premium.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ultra-professional.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/final-signature.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/professional-refinement.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive-final.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/final-experience.css" asp-append-version="true" />
</head>
<body class="login-body auth-page auth-step-@(activeTab)" data-auth-step="@(activeTab)" data-login-url="@Url.Action("Index", "IniciarSesion1")" data-code-result="@((ViewBag.CodeVerificationState as string) ?? "")" data-code-result-next="@((ViewBag.CodeVerificationNext as string) ?? activeTab)" style="--accent:@appSettings.PrimaryColor;--accent2:@appSettings.PrimaryDarkColor;--accent-soft:@appSettings.PrimarySoftColor;--bg:@appSettings.BackgroundColor;--white:@appSettings.SurfaceColor;--ink:@appSettings.TextColor;--muted:@appSettings.MutedColor;--line:@appSettings.LineColor;">
    <div class="login-bg-glow glow-one"></div>
    <div class="login-bg-glow glow-two"></div>

    <div class="login-intro-splash" aria-hidden="true">
        <div class="login-intro-mark">
            <img src="@appSettings.LogoPath" alt="" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
            <span>R</span>
        </div>
        <span class="eyebrow">@appSettings.RestaurantName</span>
        <h1>Le damos una cordial bienvenida</h1>
        <p>Es un placer recibirte en RestauranteBD.</p>
    </div>

    <main class="login-page-shell">
        <section class="login-welcome">
            <div class="login-logo login-logo-large">
                <img src="@appSettings.LogoPath" alt="Logo del restaurante" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
                <span>R</span>
            </div>
            <span class="eyebrow">@appSettings.RestaurantName</span>
            <h1>Le damos una cordial bienvenida</h1>
            <p class="login-welcome-copy">Es un placer recibirte en RestauranteBD. Inicia sesión para continuar con una experiencia clara, cómoda y pensada para ti.</p>

            <div class="login-info-grid login-info-grid-single">
                <article>
                    <span class="login-info-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none">
                            <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.7"/>
                            <path d="M12 7v5l3.2 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </span>
                    <div>
                        <strong>Horario de atención</strong>
                        <span>Todos los días · @appSettings.OpeningTime a @appSettings.ClosingTime</span>
                    </div>
                </article>
            </div>
        </section>

        <section class="login-card login-card-professional">
            <div class="auth-result-overlay" data-auth-result hidden aria-live="polite">
                <div class="auth-result-stage" data-auth-result-stage>
                    <div class="auth-verification-tiles" aria-hidden="true">
                        <span data-result-tile>•</span><span data-result-tile>•</span><span data-result-tile>•</span>
                        <span data-result-tile>•</span><span data-result-tile>•</span><span data-result-tile>•</span>
                    </div>
                    <div class="auth-verification-dots" aria-hidden="true">
                        <i></i><i></i><i></i>
                    </div>
                    <div class="auth-result-circle auth-result-success" aria-hidden="true"><span class="auth-result-mark auth-result-check"></span></div>
                    <div class="auth-result-circle auth-result-error" aria-hidden="true"><span class="auth-result-mark auth-result-cross"></span></div>
                </div>
                <strong data-auth-result-title>Comprobando</strong>
                <span data-auth-result-text>Validando tu código de seguridad.</span>
            </div>

            <div class="login-tabs login-tabs-professional" role="tablist" aria-label="Acceso a RestauranteBD">
                <button type="button" class="login-tab @(activeTab == "login" ? "active" : "")" data-login-tab="login">Iniciar sesión</button>
                <button type="button" class="login-tab @(activeTab == "register" ? "active" : "")" data-login-tab="register">Crear cuenta</button>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert-error" role="status">@ViewBag.Error</div>
            }
            @if (ViewBag.Success != null)
            {
                <div class="alert-success" role="status">@ViewBag.Success</div>
            }

            <div class="auth-flow-chrome @(activeTab is "verify" or "forgot" or "resetCode" or "resetPassword" ? "" : "hidden")" data-auth-chrome>
                <div class="auth-security-head">
                    <span class="auth-security-head-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><rect x="6" y="10" width="12" height="10" rx="2.3" stroke="currentColor" stroke-width="1.6"/><path d="M8.5 10V7.7a3.5 3.5 0 0 1 7 0V10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                    </span>
                    <div>
                        <strong>Protección de tu cuenta</strong>
                        <span>Proceso seguro · los códigos duran 10 minutos</span>
                    </div>
                </div>
                <div class="auth-flow-progress" aria-label="Pasos de seguridad">
                    <div class="auth-flow-step @(flowEmailDone ? "done" : "active")"><span>1</span><strong>Correo</strong></div>
                    <i></i>
                    <div class="auth-flow-step @(flowCodeDone ? "done" : flowCodeActive ? "active" : "")"><span>2</span><strong>Código</strong></div>
                    <i></i>
                    <div class="auth-flow-step @(flowPasswordActive ? "active" : "")"><span>3</span><strong>Contraseña</strong></div>
                </div>
            </div>

            <div id="loginPanel" class="login-panel @(activeTab == "login" ? "" : "hidden")" data-auth-panel="login">
                <div class="login-heading login-heading-centered">
                    <span class="eyebrow">Acceso seguro</span>
                    <h2>Iniciar sesión</h2>
                    <p>Usa las credenciales de tu cuenta para continuar.</p>
                </div>

                <form asp-controller="IniciarSesion1" asp-action="Login" method="post" class="login-form login-form-centered" novalidate>
                    @Html.AntiForgeryToken()

                    <label>
                        Correo electrónico
                        <input name="email" type="email" value="@(ViewBag.Email ?? "")" autocomplete="username" placeholder="correo@ejemplo.com" maxlength="120" required />
                    </label>

                    <label>
                        Contraseña
                        <div class="password-field">
                            <input id="password" name="password" type="password" autocomplete="current-password" placeholder="Tu contraseña" required />
                            <button type="button" class="password-toggle" data-toggle-password="password" aria-label="Mostrar contraseña" title="Mostrar contraseña">
                                <span class="ui-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M2.7 12s3.2-6 9.3-6 9.3 6 9.3 6-3.2 6-9.3 6-9.3-6-9.3-6Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><circle cx="12" cy="12" r="2.6" stroke="currentColor" stroke-width="1.7"/></svg></span>
                            </button>
                        </div>
                    </label>

                    <div class="login-options">
                        <label class="check-row">
                            <input type="checkbox" name="remember" value="true" />
                            Mantener mi sesión activa
                        </label>
                        <span>Sesión protegida</span>
                    </div>

                    <button class="primary-btn large full login-submit" type="submit">Iniciar sesión</button>
                </form>

                <div class="login-switch-note">
                    <button type="button" data-switch-tab="forgot">¿Olvidaste tu contraseña?</button>
                </div>

                <div class="login-switch-note">
                    <span>¿Todavía no tienes una cuenta?</span>
                    <button type="button" data-switch-tab="register">Crear cuenta</button>
                </div>
            </div>

            <div id="registerPanel" class="login-panel @(activeTab == "register" ? "" : "hidden")" data-auth-panel="register">
                <div class="login-heading login-heading-centered">
                    <span class="eyebrow">Registro de cliente</span>
                    <h2>Crear cuenta</h2>
                    <p>Completa todos los datos. Al terminar confirmaremos tu correo.</p>
                </div>

                <form asp-controller="IniciarSesion1" asp-action="Registrar" method="post" class="login-form login-form-centered" id="registerForm" novalidate>
                    @Html.AntiForgeryToken()

                    <label>
                        Nombre completo
                        <input name="nombre" type="text" data-letters-only value="@(ViewBag.RegisterName ?? "")" autocomplete="name" placeholder="Tu nombre completo" minlength="3" maxlength="80" required />
                    </label>

                    <label>
                        Correo electrónico
                        <input name="email" type="email" value="@(ViewBag.RegisterEmail ?? "")" autocomplete="email" placeholder="correo@ejemplo.com" maxlength="120" required />
                    </label>

                    <div class="phone-country-field login-phone-country" data-phone-country-field data-default-country="@(ViewBag.RegisterCountryCode ?? "503")">
                        <label class="field-label">
                            País
                            <select data-country-select name="codigoPais" aria-label="País del teléfono">
                                @foreach (var country in countries)
                                {
                                    if (country.Id.Equals(selectedCountry, StringComparison.OrdinalIgnoreCase) || country.Code.Equals(selectedCountry, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <option value="@country.Id" selected>@country.Name (+@country.Code)</option>
                                    }
                                    else
                                    {
                                        <option value="@country.Id">@country.Name (+@country.Code)</option>
                                    }
                                }
                            </select>
                        </label>

                        <label class="field-label phone-number-label">
                            Teléfono
                            <input name="telefono" value="@(ViewBag.RegisterPhone ?? "")" data-international-phone inputmode="tel" autocomplete="tel" aria-describedby="phoneHelp" required />
                            <small id="phoneHelp" class="field-hint">Escribe solo el número nacional. El código se toma del país seleccionado.</small>
                        </label>
                    </div>

                    <label>
                        DUI
                        <input name="dui" type="text" data-dui inputmode="numeric" value="@(ViewBag.RegisterDui ?? "")" placeholder="00000000-0" maxlength="10" required />
                    </label>

                    <label>
                        Dirección
                        <textarea name="direccion" minlength="5" maxlength="250" rows="3" autocomplete="street-address" placeholder="Colonia, calle, número y referencia" required>@(ViewBag.RegisterAddress ?? "")</textarea>
                    </label>

                    <label>
                        Contraseña
                        <div class="password-field">
                            <input id="registerPassword" name="password" type="password" autocomplete="new-password" placeholder="Mínimo 8 caracteres" minlength="8" required />
                            <button type="button" class="password-toggle" data-toggle-password="registerPassword" aria-label="Mostrar contraseña" title="Mostrar contraseña"><span class="ui-icon">◉</span></button>
                        </div>
                    </label>

                    <label>
                        Confirmar contraseña
                        <div class="password-field">
                            <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" placeholder="Repite tu contraseña" minlength="8" required />
                            <button type="button" class="password-toggle" data-toggle-password="confirmPassword" aria-label="Mostrar contraseña" title="Mostrar contraseña"><span class="ui-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M2.7 12s3.2-6 9.3-6 9.3 6 9.3 6-3.2 6-9.3 6-9.3-6-9.3-6Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><circle cx="12" cy="12" r="2.6" stroke="currentColor" stroke-width="1.7"/></svg></span></button>
                        </div>
                    </label>

                    <div class="password-policy">
                        <span>La contraseña debe incluir</span>
                        <div><i data-password-rule="length"></i>8 caracteres</div>
                        <div><i data-password-rule="upper"></i>1 mayúscula</div>
                        <div><i data-password-rule="lower"></i>1 minúscula</div>
                        <div><i data-password-rule="number"></i>1 número</div>
                    </div>

                    <button class="primary-btn large full login-submit" type="submit">Crear cuenta</button>
                </form>

                <div class="login-switch-note">
                    <span>¿Ya tienes una cuenta?</span>
                    <button type="button" data-switch-tab="login">Iniciar sesión</button>
                </div>
            </div>

            <div class="login-panel @(activeTab == "verify" ? "" : "hidden")" data-auth-panel="verify">
                <div class="login-heading login-heading-centered">
                    <span class="eyebrow">Verificación de correo</span>
                    <h2>Confirma tu correo</h2>
                    <p>Enviamos un código de 6 dígitos a <strong>@verificationEmail</strong>.</p>
                </div>

                <form asp-controller="IniciarSesion1" asp-action="VerificarCorreo" method="post" class="login-form login-form-centered">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="@verificationEmail" />

                    <div class="code-entry" data-code-entry>
                        <div class="code-boxes" aria-label="Código de verificación">
                            @for (var i = 0; i < 6; i++)
                            {
                                <input type="text" inputmode="numeric" maxlength="1" autocomplete="one-time-code" data-code-box aria-label="Dígito @(i + 1)" />
                            }
                        </div>
                        <input class="verification-code-input code-hidden-input" name="code" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" autocomplete="one-time-code" aria-hidden="true" tabindex="-1" required />
                        <small>El código tiene 6 dígitos y vence en 10 minutos.</small>
                        <span class="verification-progress" data-code-progress hidden aria-live="polite">Verificando <i></i><i></i><i></i></span>
                    </div>

                    <button class="primary-btn large full login-submit" type="submit"><span class="btn-icon">✓</span>Confirmar correo</button>
                </form>

                <div class="auth-step-actions">
                    <form asp-controller="IniciarSesion1" asp-action="ReenviarCodigo" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="email" value="@verificationEmail" />
                        <button type="submit" class="text-action">↻ Reenviar código</button>
                    </form>
                    <button type="button" class="text-action" data-switch-tab="login">Volver a iniciar sesión</button>
                </div>
            </div>

            <div class="login-panel @(activeTab == "forgot" ? "" : "hidden")" data-auth-panel="forgot">
                <div class="login-heading login-heading-centered">
                    <span class="eyebrow">Recuperación segura</span>
                    <h2>Recuperar contraseña</h2>
                    <p>Escribe el correo de tu cuenta. Te enviaremos un código de seguridad para continuar.</p>
                </div>

                <form asp-controller="IniciarSesion1" asp-action="SolicitarRecuperacion" method="post" class="login-form login-form-centered">
                    @Html.AntiForgeryToken()
                    <label>
                        Correo electrónico
                        <input name="email" type="email" value="@recoveryEmail" autocomplete="email" placeholder="correo@ejemplo.com" maxlength="120" required />
                    </label>
                    <button class="primary-btn large full login-submit" type="submit">Enviar código</button>
                </form>

                <div class="auth-step-actions">
                    <button type="button" class="text-action" data-switch-tab="login">← Volver a iniciar sesión</button>
                </div>
            </div>

            <div class="login-panel @(activeTab == "resetCode" ? "" : "hidden")" data-auth-panel="resetCode">
                <div class="login-heading login-heading-centered">
                    <span class="eyebrow">Código de recuperación</span>
                    <h2>Ingresa el código</h2>
                    <p>Revisa tu correo e introduce el código de 6 dígitos que acabamos de enviarte.</p>
                </div>

                <form asp-controller="IniciarSesion1" asp-action="VerificarRecuperacion" method="post" class="login-form login-form-centered">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="@recoveryEmail" />
                    <div class="code-entry" data-code-entry>
                        <div class="code-boxes" aria-label="Código de recuperación">
                            @for (var i = 0; i < 6; i++)
                            {
                                <input type="text" inputmode="numeric" maxlength="1" autocomplete="one-time-code" data-code-box aria-label="Dígito @(i + 1)" />
                            }
                        </div>
                        <input class="verification-code-input code-hidden-input" name="code" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" autocomplete="one-time-code" aria-hidden="true" tabindex="-1" required />
                        <small>Por seguridad, solo podrás continuar con el código correcto.</small>
                    </div>
                    <button class="primary-btn large full login-submit" type="submit"><span class="btn-icon">✓</span>Comprobar código</button>
                </form>

                <div class="auth-step-actions">
                    <button type="button" class="text-action" data-switch-tab="forgot">← Cambiar correo</button>
                    <button type="button" class="text-action" data-switch-tab="login">Volver a iniciar sesión</button>
                </div>
            </div>

            <div class="login-panel @(activeTab == "resetPassword" ? "" : "hidden")" data-auth-panel="resetPassword">
                <div class="login-heading login-heading-centered">
                    <span class="eyebrow">Nueva contraseña</span>
                    <h2>Cambia tu contraseña</h2>
                    <p>Tu identidad ya fue confirmada. Define una contraseña nueva para volver a entrar a tu cuenta.</p>
                </div>

                <form asp-controller="IniciarSesion1" asp-action="RestablecerPassword" method="post" class="login-form login-form-centered">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="@recoveryEmail" />

                    <label>
                        Nueva contraseña
                        <div class="password-field">
                            <input id="resetPassword" name="password" type="password" minlength="8" autocomplete="new-password" placeholder="Mínimo 8 caracteres" required />
                            <button type="button" class="password-toggle" data-toggle-password="resetPassword" aria-label="Mostrar contraseña" title="Mostrar contraseña"><span class="ui-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M2.7 12s3.2-6 9.3-6 9.3 6 9.3 6-3.2 6-9.3 6-9.3-6-9.3-6Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><circle cx="12" cy="12" r="2.6" stroke="currentColor" stroke-width="1.7"/></svg></span></button>
                        </div>
                    </label>

                    <label>
                        Confirmar contraseña
                        <div class="password-field">
                            <input id="confirmResetPassword" name="confirmPassword" type="password" minlength="8" autocomplete="new-password" placeholder="Repite tu contraseña" required />
                            <button type="button" class="password-toggle" data-toggle-password="confirmResetPassword" aria-label="Mostrar contraseña" title="Mostrar contraseña"><span class="ui-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M2.7 12s3.2-6 9.3-6 9.3 6 9.3 6-3.2 6-9.3 6-9.3-6-9.3-6Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><circle cx="12" cy="12" r="2.6" stroke="currentColor" stroke-width="1.7"/></svg></span></button>
                        </div>
                    </label>

                    <button class="primary-btn large full login-submit" type="submit"><span class="btn-icon">✓</span>Guardar nueva contraseña</button>
                </form>
                <div class="auth-step-actions">
                    <button type="button" class="text-action" data-switch-tab="resetCode">← Volver al código</button>
                    <button type="button" class="text-action" data-switch-tab="login">Cancelar y volver al inicio</button>
                </div>
            </div>
        </section>
    </main>

    <footer class="login-footer professional-footer">@appSettings.RestaurantName · Acceso y gestión del restaurante</footer>

    <script src="~/js/modules/validation.js" asp-append-version="true"></script>
    <script src="~/js/modules/auth.js" asp-append-version="true"></script>
</body>
</html>
