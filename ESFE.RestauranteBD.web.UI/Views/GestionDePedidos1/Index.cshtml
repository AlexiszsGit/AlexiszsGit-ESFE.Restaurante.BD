@{
    Layout = "_Layout";
    ViewData["Title"] = "Pedidos";
}

<section class="page-shell">
    <div class="page-head">
        <div>
            <span class="eyebrow">Operación</span>
            <h2>Gestión de pedidos</h2>
            <p>Consulta y actualiza el estado de cada pedido.</p>
        </div>
        <div class="page-head-actions">
            <button class="secondary-btn" onclick="ESFERestaurante.orders.render()"><span class="action-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M20 12a8 8 0 1 1-2.34-5.66" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M20 5v5h-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Actualizar</button>
            <button id="openLocalOrderButton" class="primary-btn" type="button" onclick="ESFERestaurante.localOrders.open()"><span class="action-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg></span>Pedido presencial</button>
        </div>
    </div>

    <div class="stats-grid compact">
        <div class="stat-card">
            <span>Total</span>
            <strong id="ordersTotal">0</strong>
            <small>Pedidos registrados</small>
        </div>
        <div class="stat-card">
            <span>Pendientes</span>
            <strong id="ordersPending">0</strong>
            <small>Esperando cocina</small>
        </div>
        <div class="stat-card">
            <span>Preparando</span>
            <strong id="ordersPreparing">0</strong>
            <small>En proceso</small>
        </div>
        <div class="stat-card">
            <span>Listos</span>
            <strong id="ordersReady">0</strong>
            <small>Para entregar</small>
        </div>
    </div>

    <section class="panel">
        <div class="toolbar-row">
            <div class="filter-tabs">
                <button class="filter-chip active" data-status="Todos" onclick="ESFERestaurante.orders.setFilter('Todos')">Todos</button>
                <button class="filter-chip" data-status="Pendiente" onclick="ESFERestaurante.orders.setFilter('Pendiente')">Pendientes</button>
                <button class="filter-chip" data-status="Preparando" onclick="ESFERestaurante.orders.setFilter('Preparando')">Preparando</button>
                <button class="filter-chip" data-status="Listo" onclick="ESFERestaurante.orders.setFilter('Listo')">Listos</button>
            </div>
            <div class="search-box small">
                <span class="ui-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
                <input id="ordersSearch" placeholder="Nombre, correo, ID, teléfono o DUI..." oninput="ESFERestaurante.orders.render()" />
            </div>
        </div>

        <div id="ordersGrid" class="orders-grid"></div>
    </section>
</section>

<div id="localOrderModal" class="modal-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="localOrderTitle">
    <div class="modal-card local-order-modal">
        <div class="panel-head">
            <div>
                <span class="eyebrow">Atención en salón</span>
                <h3 id="localOrderTitle">Nuevo pedido presencial</h3>
                <p>Registra una orden para un cliente que llegó al restaurante. La orden seguirá el mismo flujo de cocina.</p>
            </div>
            <button type="button" class="icon-btn" onclick="ESFERestaurante.localOrders.close()" aria-label="Cerrar"><span class="ui-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m7 7 10 10M17 7 7 17" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg></span></button>
        </div>

        <div class="local-order-grid">
            <section>
                <div class="form-grid-two">
                    <label class="field-label">Nombre del cliente
                        <input id="localCustomerName" type="text" data-letters-only maxlength="80" placeholder="Nombre y apellido" required />
                    </label>
                    <label class="field-label">Teléfono
                        <input id="localCustomerPhone" type="text" inputmode="numeric" data-phone maxlength="9" placeholder="0000-0000" />
                    </label>
                    <label class="field-label">Tipo de pedido
                        <select id="localOrderType">
                            <option value="Consumo en restaurante">Consumo en restaurante</option>
                            <option value="Para llevar">Para llevar</option>
                        </select>
                    </label>
                    <label class="field-label">Mesa
                        <input id="localTable" type="number" min="1" max="50" placeholder="Ej. 8" />
                    </label>
                </div>

                <div class="local-product-add">
                    <label class="field-label">Producto
                        <select id="localProduct"></select>
                    </label>
                    <label class="field-label local-qty-field">Cantidad
                        <input id="localQuantity" type="number" min="1" max="20" value="1" />
                    </label>
                    <button class="secondary-btn" type="button" onclick="ESFERestaurante.localOrders.addLine()">Agregar</button>
                </div>
            </section>

            <aside class="local-order-summary">
                <div class="panel-head compact-head">
                    <div>
                        <span class="eyebrow">Detalle</span>
                        <h3>Pedido actual</h3>
                    </div>
                    <strong id="localOrderTotal">$0.00</strong>
                </div>
                <div id="localOrderLines" class="local-order-lines"></div>
                <label class="field-label">Método de pago
                    <select id="localPayment">
                        <option value="Efectivo">Efectivo</option>
                        <option value="Tarjeta">Tarjeta</option>
                        <option value="Transferencia">Transferencia</option>
                    </select>
                </label>
                <button class="primary-btn large full" type="button" onclick="ESFERestaurante.localOrders.create()">Crear pedido</button>
            </aside>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => ESFERestaurante.orders.init());
        document.addEventListener('DOMContentLoaded', () => ESFERestaurante.localOrders.init());
    </script>
}
