
@{
    Layout = "_Layout";
    ViewData["Title"] = "Pedidos";
}

<section class="page-shell">
    <div class="page-head">
        <div>
            <span class="eyebrow">Operación</span>
            <h2>Gestión de pedidos</h2>
            <p>Consulta y actualiza el estado de cada pedido.</p>
        </div>
        <div class="page-head-actions">
            <button class="secondary-btn" onclick="ESFERestaurante.orders.render()"><span class="action-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M20 12a8 8 0 1 1-2.34-5.66" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M20 5v5h-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Actualizar</button>
            <a class="secondary-btn" href="/ProcesarPago1/Index">Abrir pagos</a>
            @if (ViewBag.CanCreateLocal == true)
            {
                <button id="openLocalOrderButton" class="primary-btn local-order-launch" type="button" onclick="if(window.ESFERestaurante?.localOrders?.open){window.ESFERestaurante.localOrders.open();}else{setTimeout(()=>window.ESFERestaurante?.localOrders?.open?.(),100);}"><span class="action-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg></span>Pedido presencial</button>
            }
        </div>
    </div>

    <div class="stats-grid compact">
        <div class="stat-card">
            <span>Total</span>
            <strong id="ordersTotal">0</strong>
            <small>Pedidos registrados</small>
        </div>
        <div class="stat-card">
            <span>Pendientes</span>
            <strong id="ordersPending">0</strong>
            <small>Esperando cocina</small>
        </div>
        <div class="stat-card">
            <span>Preparando</span>
            <strong id="ordersPreparing">0</strong>
            <small>En proceso</small>
        </div>
        <div class="stat-card">
            <span>Listos</span>
            <strong id="ordersReady">0</strong>
            <small>Para entregar</small>
        </div>
    </div>

        <section class="panel">
        <div class="toolbar-row">
            <div class="filter-tabs">
                <button class="filter-chip active" data-status="Todos" onclick="ESFERestaurante.orders.setFilter('Todos')">Todos</button>
                <button class="filter-chip" data-status="Pendiente" onclick="ESFERestaurante.orders.setFilter('Pendiente')">Pendientes</button>
                <button class="filter-chip" data-status="Preparando" onclick="ESFERestaurante.orders.setFilter('Preparando')">Preparando</button>
                <button class="filter-chip" data-status="Listo" onclick="ESFERestaurante.orders.setFilter('Listo')">Listos</button>
            </div>
            <div class="search-box small">
                <span class="ui-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
                <input id="ordersSearch" placeholder="Nombre, correo, ID, teléfono o DUI..." oninput="ESFERestaurante.orders.render()" />
            </div>
        </div>

        <div id="ordersGrid" class="orders-grid"></div>
    </section>
</section>

<div id="localOrderModal" class="modal-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="localOrderTitle">
    <div class="modal-card local-order-modal local-order-modal-pro">
        <div class="panel-head">
            <div><span class="eyebrow">Punto de atención</span><h3 id="localOrderTitle">Nuevo pedido presencial</h3><p>Busca al cliente, toma la orden, asigna mesa y mesero y decide si se cobra ahora o después.</p></div>
            <button type="button" class="icon-btn" onclick="ESFERestaurante.localOrders.close()" aria-label="Cerrar">×</button>
        </div>
            <script id="localCustomerData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Customers))</script>
            <script id="localAttendantData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Attendants))</script>
        <div id="localOrderFormView" class="local-order-grid local-order-grid-pro">
                        <section>
                <div class="local-order-section-label">1 · Cliente</div>
                <div class="local-customer-mode" role="group" aria-label="Tipo de cliente">
                    <button type="button" id="registeredCustomerMode" class="secondary-btn local-customer-mode-btn active" onclick="ESFERestaurante.localOrders.setCustomerMode('registered')">Cliente registrado</button>
                    <button type="button" id="walkInCustomerMode" class="secondary-btn local-customer-mode-btn" onclick="ESFERestaurante.localOrders.setCustomerMode('walkin')">Cliente no registrado</button>
                </div>
                <div id="registeredCustomerFields">
                    <label class="field-label">Buscar cliente<input id="localCustomerSearch" list="localCustomers" type="search" autocomplete="off" placeholder="Nombre, correo, teléfono o DUI" /><datalist id="localCustomers">@foreach(var c in (ViewBag.Customers as IEnumerable<ESFE.RestauranteBD.web.UI.Models.UserAccount> ?? Array.Empty<ESFE.RestauranteBD.web.UI.Models.UserAccount>())){<option value="@c.Email">@c.Nombre · @c.Email</option>}</datalist></label>
                    <div id="localCustomerPreview" class="worker-client-preview"><span>Sin cliente seleccionado</span><strong>Busca y selecciona una cuenta para enviarle factura y notificaciones.</strong></div>
                </div>
                <div id="walkInCustomerNotice" class="local-order-policy hidden"><strong>Pedido local sin cuenta</strong><span>Registra los datos básicos del cliente manualmente. El pedido, cobro y comprobante quedan registrados en el sistema, pero no se enviarán notificaciones a una cuenta.</span></div>
                <div class="form-grid-two">
                    <label class="field-label">Nombre<input id="localCustomerName" type="text" data-letters-only maxlength="80" placeholder="Nombre del cliente" required /></label>
                    <label class="field-label">Teléfono<input id="localCustomerPhone" type="text" data-phone maxlength="20" placeholder="0000-0000" /></label>
                </div>
                <div class="local-order-section-label">2 · Servicio</div>
                <div class="form-grid-two">
                    <label class="field-label">Tipo<select id="localOrderType"><option value="Consumo en restaurante">Consumo en restaurante</option><option value="Para llevar">Para llevar</option><option value="Domicilio">Domicilio</option></select></label>
                    <label class="field-label">Mesero / responsable<select id="localAttendant"></select></label>
                    <label class="field-label">Fecha<input id="localDate" type="date" /></label>
                    <label class="field-label">Hora<input id="localTime" type="time" /></label>
                    <label class="field-label">Mesa<select id="localTable"></select></label>
                    <label class="field-label">Personas<input id="localPeople" type="number" min="1" max="20" value="2" /></label>
                    <label class="field-label local-address-field">Dirección de entrega<input id="localAddress" type="text" maxlength="250" placeholder="Solo para domicilio" /></label>
                </div>
                <div class="local-order-section-label">3 · Productos</div>
                <div class="local-menu-browser">
                    <div class="local-menu-browser-head">
                        <div><span class="eyebrow">Menú del restaurante</span><h4>Selecciona lo que desea pedir</h4><p>Explora las categorías y revisa las fotografías antes de agregar cada producto.</p></div>
                        <input id="localMenuSearch" class="local-menu-search" type="search" autocomplete="off" placeholder="Buscar producto..." aria-label="Buscar producto" />
                    </div>
                    <div id="localMenuCategories" class="local-menu-categories" role="tablist" aria-label="Categorías del menú"></div>
                    <div id="localMenuGrid" class="local-menu-grid" aria-live="polite"></div>
                </div>
                <div class="local-product-add local-product-add-pro local-product-legacy"><label class="field-label">Producto<select id="localProduct"></select></label><label class="field-label local-qty-field">Cantidad<input id="localQuantity" type="number" min="1" max="20" value="1" /></label><button class="secondary-btn" type="button" onclick="ESFERestaurante.localOrders.addLine()">Agregar</button></div>
            </section>
            @* Acciones y resumen de esta pantalla. *@
            <aside class="local-order-summary local-order-summary-pro">
                <div class="panel-head compact-head"><div><span class="eyebrow">4 · Cobro</span><h3>Resumen</h3></div><strong id="localOrderTotal" data-usd-amount="0">$0.00</strong></div>
                <div id="localOrderLines" class="local-order-lines"></div>
                <div class="local-summary-mini"><div><span>Subtotal</span><strong id="localOrderSubtotal" data-usd-amount="0">$0.00</strong></div><div><span>IVA @AppSettingsStore.Current.TaxPercent%</span><strong id="localOrderTax" data-usd-amount="0">$0.00</strong></div><div class="grand"><span>Total</span><strong id="localOrderTotalMirror" data-usd-amount="0">$0.00</strong></div></div>
                <div class="local-payment-choice-group">
                    <div class="local-payment-choice-heading"><span class="eyebrow">Forma de pago</span><strong>¿Cómo paga el cliente?</strong><small>El total se toma automáticamente de los productos del pedido.</small></div>
                    <div class="local-payment-method-switch" role="group" aria-label="Método de pago">
                        <button type="button" class="local-payment-method-btn active" data-payment-method="Efectivo">
                            <span class="payment-tab-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><rect x="4" y="5" width="16" height="14" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M7.5 9.5h9M7.5 14.5h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span>
                            <span><strong>Efectivo</strong><small>En caja</small></span>
                        </button>
                        <button type="button" class="local-payment-method-btn" data-payment-method="Tarjeta">
                            <span class="payment-tab-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><rect x="3.5" y="5" width="17" height="14" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M3.5 10h17" stroke="currentColor" stroke-width="1.7"/></svg></span>
                            <span><strong>Tarjeta</strong><small>Terminal / POS</small></span>
                        </button>
                        <button type="button" class="local-payment-method-btn" data-payment-method="Transferencia">
                            <span class="payment-tab-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><rect x="4" y="4.5" width="16" height="15" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M8 9h8M8 13h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span>
                            <span><strong>Transferencia</strong><small>Referencia</small></span>
                        </button>
                    </div>
                    <select id="localPayment" class="local-payment-hidden-select" aria-hidden="true" tabindex="-1"><option value="Efectivo">Efectivo</option><option value="Tarjeta">Tarjeta</option><option value="Transferencia">Transferencia</option></select>
                </div>

                <div class="local-payment-choice-group">
                    <div class="local-payment-choice-heading"><span class="eyebrow">Momento del cobro</span><strong>¿Se cobra ahora o después?</strong></div>
                    <div class="local-payment-timing-switch" role="group" aria-label="Momento del pago">
                        <button type="button" class="local-payment-timing-btn active" data-payment-timing="Pendiente">Cobrar después<span>Queda pendiente</span></button>
                        <button type="button" class="local-payment-timing-btn" data-payment-timing="Pagado">Cobrar ahora<span>Registrar pago</span></button>
                    </div>
                    <select id="localPaymentTiming" class="local-payment-hidden-select" aria-hidden="true" tabindex="-1"><option value="Pendiente">Cliente paga después</option><option value="Pagado">Cobrar y registrar ahora</option></select>
                </div>

                <div id="localCustomerPolicy" class="local-order-policy"><strong>Cuenta registrada</strong><span>Recibirá una notificación con el detalle. Si el pago queda pendiente, podrá abrir el pago desde allí.</span></div>

                <div id="localImmediatePayment" class="local-immediate-payment hidden" aria-live="polite">
                    <div class="local-immediate-payment-head">
                        <div><span class="eyebrow">Pago inmediato</span><strong>Datos del cobro</strong><small>Elige el método y completa solo los datos necesarios para finalizar este pedido.</small></div>
                        <span class="local-payment-status-badge">Cobrar ahora</span>
                    </div>
                    <div id="localPaymentFields" class="local-payment-fields"></div>
                </div>

                <button id="localCreateOrderButton" class="primary-btn large full" type="button" onclick="ESFERestaurante.localOrders.create()"><span class="action-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12.5 9.5 17 19 7.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span data-order-submit-label>Crear pedido presencial</span></button>
            </aside>
        </div>
    </div>
</div>

@* Scripts necesarios para el funcionamiento de esta vista. *@
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => ESFERestaurante.orders.init());
        document.addEventListener('DOMContentLoaded', () => ESFERestaurante.localOrders.init());
    </script>
}
