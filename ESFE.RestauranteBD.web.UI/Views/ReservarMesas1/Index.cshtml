
@{
    Layout = "_Layout";
    ViewData["Title"] = "Reservas";
    var rol = Context.Session.GetString("RolUsuario") ?? "Cliente";
    var esTrabajador = RoleStore.IsAdministrator(rol) || rol == "Barra";
}

@* Contenido principal de la página. *@
<section class="page-shell">
    <div class="page-head">
        <div>
            <span class="eyebrow">@(esTrabajador ? "Control de mesas" : "Reservación")</span>
            <h2>@(esTrabajador ? "Estado de las mesas" : "Reserva tu mesa")</h2>
            <p>@(esTrabajador ? "Consulta todas las reservas, disponibilidad y si el cliente ya llegó." : "Selecciona una mesa, fecha y hora para reservar. Horario oficial: 6:00 a. m. a 10:00 p. m.")</p>
        </div>
        <span class="legend">
            <i class="legend-dot available"></i>Disponible
            <i class="legend-dot occupied"></i>Ocupada
        </span>
    </div>

    <div class="reservation-layout">
        @* Contenido principal de la página. *@
        <section class="panel floor-panel">
            <div class="floor-head">
                <div>
                    <h3>Croquis del restaurante</h3>
                    <p>12 mesas distribuidas por zona.</p>
                </div>
                <span class="floor-tag">ENTRADA PRINCIPAL</span>
            </div>

            <div class="floor-plan">
                <div class="floor-label entrance">ENTRADA</div>
                <div class="floor-label kitchen">COCINA</div>
                <div class="floor-label bar">BARRA</div>
                <div class="floor-label restroom">BAÑOS</div>
                <div id="tablesMap" class="tables-map"></div>
            </div>
        </section>

        @if (!esTrabajador)
        {
            @* Resumen y acciones secundarias de la vista. *@
            <aside class="panel reservation-form-panel">
                <span class="eyebrow">Detalles</span>
                <h3>Datos de la reserva</h3>

                <div id="selectedTableBox" class="selected-table-box">
                    <span>Mesa</span>
                    <strong id="selectedTable">Selecciona una mesa</strong>
                    <small id="selectedTableInfo">Elige una mesa disponible en el croquis.</small>
                </div>

                <div class="form-stack">
                    <label class="field-label">
                        Nombre completo
                        <input id="reserveName" type="text" data-letters-only minlength="3" maxlength="80" pattern="[A-Za-zÁÉÍÓÚÜÑáéíóúüñÀ-ÿ' -]+" required placeholder="Nombre del cliente" />
                    </label>

                    <label class="field-label">
                        Personas
                        <select id="reservePeople">
                            <option>1</option>
                            <option>2</option>
                            <option>3</option>
                            <option>4</option>
                            <option>5</option>
                            <option>6</option>
                            <option>8</option>
                            <option>10</option>
                        </select>
                    </label>

                    <div class="two-col">
                        <label class="field-label">
                            Fecha
                            <input id="reserveDate" type="date" />
                        </label>
                        <label class="field-label">
                            Hora
                            <input id="reserveTime" type="time" />
                        </label>
                    </div>

                    <button class="primary-btn large full" onclick="ESFERestaurante.reservas.save()">
                        Confirmar reservación <span>✓</span>
                    </button>
                </div>
            </aside>
        }
        else
        {
            @* Resumen y acciones secundarias de la vista. *@
            <aside class="panel reservation-form-panel owner-table-summary">
                <span class="eyebrow">Operación de sala</span>
                <h3>Reserva y llegada presencial</h3>
                <p class="form-help">Barra y administrador pueden registrar la llegada, la inasistencia y la salida de una reserva. Una inasistencia libera la mesa; una llegada la mantiene ocupada hasta registrar la salida.</p>

                <div class="walkin-form-block">
                    <label class="field-label">
                        Mesa
                        <select id="walkInTable"></select>
                    </label>
                    <label class="field-label">
                        Nombre del cliente
                        <input id="walkInName" type="text" data-letters-only minlength="3" maxlength="80" required />
                    </label>
                    <label class="field-label">
                        Personas
                        <input id="walkInPeople" type="number" min="1" max="12" step="1" value="2" required />
                    </label>
                    <div class="two-col">
                        <label class="field-label">
                            Fecha
                            <input id="walkInDate" type="date" />
                        </label>
                        <label class="field-label">
                            Hora
                            <input id="walkInTime" type="time" />
                        </label>
                    </div>
                    <button type="button" class="primary-btn full" onclick="ESFERestaurante.reservas.createWalkIn()">Registrar reserva presencial</button>
                </div>

                <div class="table-status-key">
                    <div>
                        <i class="legend-dot available"></i>
                        <strong>Disponible</strong>
                        <small>Puede reservarla un cliente.</small>
                    </div>
                    <div>
                        <i class="legend-dot occupied"></i>
                        <strong>Reservada</strong>
                        <small>Bloqueada para una reserva válida en ese horario.</small>
                    </div>
                    <div>
                        <i class="legend-dot warning"></i>
                        <strong>Fuera de horario</strong>
                        <small>La mesa permanece disponible, pero la reserva queda registrada para control.</small>
                    </div>
                </div>
            </aside>
        }
    </div>

    @* Contenido principal de la página. *@
    <section class="panel">
        <div class="panel-head">
            <div>
                <span class="eyebrow">Agenda</span>
                <h3>Reservas y llegadas de hoy</h3>
            </div>
            <span id="reservationCount" class="result-count">0</span>
        </div>
        <div id="reservationList" class="reservation-list"></div>
    </section>
</section>

@* Scripts necesarios para el funcionamiento de esta vista. *@
@section Scripts {
    @* Datos que la vista expone al JavaScript. *@
    <script src="~/js/modules/reservations.js" asp-append-version="true"></script>
    @* Datos que la vista expone al JavaScript. *@
    <script>
        document.addEventListener('DOMContentLoaded', () => ESFERestaurante.reservas.init());
    </script>
}
